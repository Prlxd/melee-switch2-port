+// ---- call trace (boot test diagnostics) ----
+// Every host callback goes through Tracer: sdmc:/switch/melee/logs/trace.log gets one line per change of callback
+// ("name xCOUNT from +OFFSET", the offset of the game code that called it), so the last line written
+// before a crash says what the game last asked of the host, and from where.
+FILE* trace_file = nullptr;
+const char* trace_last = nullptr;
+uintptr_t trace_last_from = 0;
+uint64_t trace_repeat = 0;
+uint64_t trace_lines = 0;
+volatile uint64_t trace_calls = 0;
+volatile const char* trace_now = "start";
+void trace_flush_pending() {
+  if (trace_file && trace_last) {
+    std::fprintf(trace_file, "%s x%llu from +0x%llx\n", trace_last, (unsigned long long)trace_repeat,
+                 (unsigned long long)(trace_last_from - image_lo));
+    std::fflush(trace_file);
+    ++trace_lines;
+  }
+}
+void trace_enter(const char* name, uintptr_t from) {
+  ++trace_calls;
+  trace_now = name;
+  if (!trace_file || trace_lines > 200000) return;
+  if (name == trace_last && from == trace_last_from) { ++trace_repeat; return; }
+  trace_flush_pending();
+  trace_last = name; trace_last_from = from; trace_repeat = 1;
+  // Write the new call at once too: if it never returns, the file already names it.
+  std::fprintf(trace_file, "> %s from +0x%llx\n", name, (unsigned long long)(from - image_lo));
+  std::fflush(trace_file);
+}
+template<typename F, F f> struct Tracer;
+template<typename R, typename... A, R (*f)(A...)> struct Tracer<R (*)(A...), f> {
+  static const char* name;
+  __attribute__((noinline)) static R call(A... a) {
+    trace_enter(name, reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+    return f(a...);
+  }
+};
+template<typename R, typename... A, R (*f)(A...)> const char* Tracer<R (*)(A...), f>::name = "?";
+#define TRACED(fn) ([] { Tracer<decltype(&fn), &fn>::name = #fn; return &Tracer<decltype(&fn), &fn>::call; }())
+
+// Card calls are rare: log each with its result (boot test diagnostics).
+template<typename F, F f> struct CardLog;
+template<typename... A, int32_t (*f)(A...)> struct CardLog<int32_t (*)(A...), f> {
+  static const char* name;
+  static int32_t call(A... a) { const int32_t r = f(a...); if (r != 0) log("card: %s -> %d", name, r); return r; }
+};
+template<typename... A, int32_t (*f)(A...)> const char* CardLog<int32_t (*)(A...), f>::name = "?";
+#define CARDLOG(fn) ([] { CardLog<decltype(&fn), &fn>::name = #fn; return &CardLog<decltype(&fn), &fn>::call; }())
+
