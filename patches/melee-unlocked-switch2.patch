+// ---- .slp recording (Slippi option only) ----
+// The game sends Slippi's replay events (Game Start 0x36, frames, Game End 0x39); they are kept in
+// memory as melee-unlocked's Source Port host does (app/source_host.cpp) and written as
+// replays/Game_<start time>.slp at Game End, or when the next match starts or the game quits.
+slippi::NativeReplayStream g_replay_stream;
+bool g_replay_written = true;
+uint32_t g_online_games = 0;
+void write_replay_recording() {
+  if (g_replay_written || !g_replay_stream.active()) return;
+  g_replay_written = true;
+  std::vector<uint8_t> file = g_replay_stream.encode();
+  if (file.empty()) { log("replay: recording failed: %s", g_replay_stream.error().c_str()); return; }
+  std::time_t start = g_replay_stream.start_time() ? std::time_t(g_replay_stream.start_time()) : std::time(nullptr);
+  std::tm tm{};
+  localtime_r(&start, &tm);
+  char name[64];
+  std::strftime(name, sizeof name, "Game_%Y%m%dT%H%M%S", &tm);
+  std::error_code ec;
+  std::filesystem::create_directories(MU_SD_DIR "/replays", ec);
+  const uint64_t t0 = armGetSystemTick();
+  for (unsigned suffix = 0; suffix < 1000; ++suffix) {
+    const std::string path = std::string(MU_SD_DIR "/replays/") + name + (suffix ? "_" + std::to_string(suffix) : "") + ".slp";
+    if (std::filesystem::exists(path, ec)) continue;
+    FILE* f = std::fopen(path.c_str(), "wb");
+    if (!f) { log("replay: cannot write %s", path.c_str()); return; }
+    const bool ok = std::fwrite(file.data(), 1, file.size(), f) == file.size();
+    const bool closed = std::fclose(f) == 0;
+    log("replay: %s %s (%zu bytes, %llu ms)", ok && closed ? "recording written to" : "write failed for", path.c_str(),
+        file.size(), (unsigned long long)(armTicksToNs(armGetSystemTick() - t0) / 1000000));
+    return;
+  }
+}
+void h_replay_event(uint8_t command, const uint8_t* payload, uint32_t size) {
+  if (!slippi_mode) return;
+  if (command == 0x36) {
+    write_replay_recording();
+    // Game Start payload (no command byte): 0x1A3 major scene, 0x2BD the online match id, 0x2F0 the game number.
+    std::vector<uint8_t> start(payload, payload + size);
+    const bool online = size >= 0x2F8 && (start[0x1A3] == 0x08 || start[0x2BD] != 0);
+    std::vector<uint8_t> codes;
+    if (online) {
+      codes.assign(std::begin(native_online_recording_codes), std::end(native_online_recording_codes));
+      const uint32_t game = ++g_online_games;
+      for (int b = 0; b < 4; ++b) start[0x2F0 + b] = uint8_t(game >> (24 - 8 * b));
+    } else {
+      codes.assign(std::begin(native_recording_codes), std::end(native_recording_codes));
+    }
+    g_replay_written = false;
+    if (!g_replay_stream.begin_slippi(start, codes, int64_t(std::time(nullptr))))
+      log("replay: cannot start recording: %s", g_replay_stream.error().c_str());
+    else if (online) log("replay: recording online game %u", unsigned(g_online_games));
+    return;
+  }
+  if (!g_replay_stream.active() || g_replay_stream.ended()) return;   // Dolphin closes the file at Game End
+  if (!g_replay_stream.append(command, payload, size))
+    log("replay: cannot record event %02X: %s", command, g_replay_stream.error().c_str());
+  if (command == 0x39) write_replay_recording();
+}
+void h_replay_finished() { write_replay_recording(); }
