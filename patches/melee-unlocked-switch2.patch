+namespace {
+int game_result = 0;
+// The game runs on its own thread with a 16 MB stack: the PC builds give it 8 MB, and the stack an NRO's
+// main thread gets is the loader's choice. setjmp/longjmp (stops, panics) stay on this thread.
+void game_thread(void*) {
+#ifdef MU_SWITCH_GRAPHICS
+  // GX decoding and presentation run on the thread that creates the renderer: the game's thread.
+  try {
+    std::error_code ec;
+    std::filesystem::create_directories(MU_SD_DIR "/shader-cache", ec);
+    // Mesa and the renderer report on stderr: keep it. Translate shaders on this thread (16 MB stack)
+    // rather than on worker threads with the default stack; each shader is then cached on the SD card.
+    if (g_logging) {
+      std::freopen(MU_LOG_DIR "/gl.log", "w", stderr);
+      std::setvbuf(stderr, nullptr, _IOLBF, 1024);
+    }   // each line reaches the card at once, so a crash keeps them
+    setenv("MELEE_SYNC_SHADERS", "1", 1);
+    load_settings();
+    gx::set_menu_widescreen_fill(settings.widescreen == 2);
+    log("video: widescreen %s, internal resolution x%g; tap jump %s",
+        settings.widescreen == 2 ? "16:9, menus stretched to the edges" : settings.widescreen ? "16:9" : "off (4:3)",
+        settings.scale, slippi_mode || settings.tap_jump ? "on" : "off");
+    crumbs_report_previous();
+    if (config_value_early("crashtrail") == "1") { crumbs_start(); mu_crumbs_on = crumb_file != nullptr; log("crashtrail: on (the game will run slowly)"); }
+    log("cpus: 20XX AI %s (cpu20xx=%d)", cpu_20xx_on() ? "on" : "off", settings.cpu_20xx);
+    if (g_sweep_requested) sweep_start();
+    if (te_mode) log("20xx: Tournament Edition on (settings: VS Mode > Tournament Melee)");
+    if (hp_te_words() || te_mode) { load_te_words(); log("20xx: menu options %08X %08X", unsigned(te_w1), unsigned(te_w2)); }
+    renderer = linux_renderer::create_switch_threaded(&window_handle, MU_SD_DIR "/shader-cache", render_core,
+                                                      settings.scale, settings.widescreen != 0);
+    if (renderer) {
+      log("renderer: on its own thread (core %d)", render_core);
+      gx::init(renderer.get());   // the decoder records draws only with a backend attached (port/linux/main.cpp)
+      linux_renderer::connect_host();
+      log("renderer: OpenGL renderer ready");
+    }
+    else log("renderer: create returned nothing");
+  } catch (const std::exception& e) {
+    log("renderer: cannot start: %s", e.what());
+    renderer.reset();
+  }
+#endif
+  running = true;
+  if (setjmp(stop_boundary) == 0) game_result = game.run();
+  else game_result = stop_code;
+  running = false;
+  mu_quit_note("game thread: the game has stopped");
+#ifdef MU_SWITCH_GRAPHICS
+  // Shut the renderer down on this thread (its GL context's): it saves the full list of shader programs
+  // the session built, so the next launch builds them all before the game starts instead of mid-match.
+  if (renderer) {
+    try { mu_quit_note("game thread: detaching the GX decoder"); gx::init(nullptr);
+          mu_quit_note("game thread: closing the renderer"); renderer.reset();
+          mu_quit_note("game thread: renderer closed"); log("renderer: closed, shader list saved"); }
+    catch (const std::exception& e) { log("renderer: close failed: %s", e.what()); }
+  }
+#endif
+}
