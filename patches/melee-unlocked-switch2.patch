diff --git a/sourceport/game/include/mu_native.h b/sourceport/game/include/mu_native.h
index 4953a39..0126abe 100644
--- a/sourceport/game/include/mu_native.h
+++ b/sourceport/game/include/mu_native.h
@@ -3,6 +3,32 @@
 #ifndef MU_NATIVE_H
 #define MU_NATIVE_H
 
+/* Where the console's main memory lives. On PC it is mapped at the console's own 0x80000000. On
+ * Switch 2 (kaiHEN) it is a block inside the NRO, which loads at 0x08000000, below 4 GB, so the
+ * game's 32-bit pointer slots still hold real addresses. Console physical addresses (pointer minus
+ * 0x80000000, in 32-bit arithmetic) round-trip either way. What changes is how an address is told
+ * apart from an ARAM offset: ARAM offsets are small, and on Switch every pointer the game owns is
+ * at or above the NRO's load address. */
+#if defined(MU_SWITCH2)
+extern unsigned char mu_mem1[];
+#define MU_MEM1_BASE ((unsigned long) (void*) mu_mem1)
+#define MU_GUEST_FLOOR 0x08000000u      /* below this: an ARAM offset, never a game pointer */
+#else
+#define MU_MEM1_BASE 0x80000000ul
+#define MU_GUEST_FLOOR 0x80000000u
+#endif
+/* The CPU's 16 KB locked cache (THP video decoding scratch). On PC the host maps it at the console's
+ * 0xE0000000; on Switch 2 it is a buffer inside the NRO, below 4 GB like everything else. */
+#if defined(MU_SWITCH2)
+extern unsigned char mu_locked_cache[];
+#define MU_LOCKED_CACHE ((unsigned long) (void*) mu_locked_cache)
+#else
+#define MU_LOCKED_CACHE 0xE0000000ul
+#endif
+/* A pointer inside the console's original 24 MB of MEM1 (the game's own validity checks). */
+#define MU_IN_CONSOLE_MEM1(p) \
+    ((unsigned long) (p) >= MU_MEM1_BASE && (unsigned long) (p) < MU_MEM1_BASE + 0x01800000ul)
+
 /* Console code also uses NULL in integer contexts and variadic pointer lists. */
 #ifndef NULL
 #define NULL 0LL
diff --git a/sourceport/game/include/mu_shim.h b/sourceport/game/include/mu_shim.h
index 5acc8eb..79156f6 100644
--- a/sourceport/game/include/mu_shim.h
+++ b/sourceport/game/include/mu_shim.h
@@ -32,6 +32,13 @@ static inline void* mu_phys_ptr(unsigned int phys) { return (void*) (uintptr_t)
  * 0xC0000000 and up can only be one of them with the segment bit taken off. */
 static inline void* mu_mem_ptr(unsigned int addr)
 {
+#if defined(MU_SWITCH2)
+    /* Switch 2: everything the game owns is in the NRO, at 0x08000000 and up but below 1 GB.
+     * Its physical form (minus 0x80000000) is 0x88000000 and up; its uncached form 0x48000000 and up. */
+    if (addr >= MU_GUEST_FLOOR && addr < 0x40000000u) return (void*) (uintptr_t) addr;
+    if (addr >= MU_GUEST_FLOOR + 0x40000000u && addr < 0x80000000u) return (void*) (uintptr_t) (addr - 0x40000000u);
+    return mu_phys_ptr(addr);
+#endif
