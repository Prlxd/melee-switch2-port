+void retrace() {
+  check_stop();
+  count.ticks = std::max(count.ticks, next_retrace);
+  pace_to(count.ticks);
+  next_retrace += ticks_per_frame;
+  ++count.retraces;
+  pump_events();
+  deliver_completions();
+  audio_tick();
+  if (game.fire_alarms) game.fire_alarms(count.ticks);
+  if (game.retrace) game.retrace();
+  report_progress();
+  if (cfg.max_frames && count.retraces >= cfg.max_frames) request_stop(0);
+  check_stop();
+}
