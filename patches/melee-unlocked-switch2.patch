+namespace {
+int game_result = 0;
+// The game runs on its own thread with a 16 MB stack: the PC builds give it 8 MB, and the stack an NRO's
+// main thread gets is the loader's choice. setjmp/longjmp (stops, panics) stay on this thread.
+void game_thread(void*) {
+#ifdef MU_SWITCH_GRAPHICS
+  // GX decoding and presentation run on the thread that creates the renderer: the game's thread.
+  try {
+    std::error_code ec;
+    std::filesystem::create_directories("sdmc:/melee/shader-cache", ec);
+    // Mesa and the renderer report on stderr: keep it. Translate shaders on this thread (16 MB stack)
+    // rather than on worker threads with the default stack; each shader is then cached on the SD card.
+    if (g_logging) {
+      std::freopen("sdmc:/melee/gl.log", "w", stderr);
+      std::setvbuf(stderr, nullptr, _IOLBF, 1024);
+    }   // each line reaches the card at once, so a crash keeps them
+    setenv("MELEE_SYNC_SHADERS", "1", 1);
+    load_settings();
+    gx::set_menu_widescreen_fill(settings.widescreen == 2);
+    log("video: widescreen %s, internal resolution x%g; tap jump %s",
+        settings.widescreen == 2 ? "16:9, menus stretched to the edges" : settings.widescreen ? "16:9" : "off (4:3)",
+        settings.scale, settings.tap_jump ? "on" : "off");
+    crumbs_report_previous();
+    if (config_value_early("crashtrail") == "1") { crumbs_start(); mu_crumbs_on = crumb_file != nullptr; log("crashtrail: on (the game will run slowly)"); }
+    log("cpus: 20XX AI %s (cpu20xx=%d)", cpu_20xx_on() ? "on" : "off", settings.cpu_20xx);
+    if (g_sweep_requested) sweep_start();
+    if (te_mode) log("20xx: Tournament Edition on (settings: VS Mode > Tournament Melee)");
+    if (hp_te_words() || te_mode) { load_te_words(); log("20xx: menu options %08X %08X", unsigned(te_w1), unsigned(te_w2)); }
+    renderer = linux_renderer::create_switch_threaded(&window_handle, "sdmc:/melee/shader-cache", render_core,
+                                                      settings.scale, settings.widescreen != 0);
+    if (renderer) {
+      log("renderer: on its own thread (core %d)", render_core);
+      gx::init(renderer.get());   // the decoder records draws only with a backend attached (port/linux/main.cpp)
+      linux_renderer::connect_host();
+      log("renderer: OpenGL renderer ready");
+    }
+    else log("renderer: create returned nothing");
+  } catch (const std::exception& e) {
+    log("renderer: cannot start: %s", e.what());
+    renderer.reset();
+  }
+#endif
+  running = true;
+  if (setjmp(stop_boundary) == 0) game_result = game.run();
+  else game_result = stop_code;
+  running = false;
+  mu_quit_note("game thread: the game has stopped");
+#ifdef MU_SWITCH_GRAPHICS
+  // Shut the renderer down on this thread (its GL context's): it saves the full list of shader programs
+  // the session built, so the next launch builds them all before the game starts instead of mid-match.
+  if (renderer) {
+    try { mu_quit_note("game thread: detaching the GX decoder"); gx::init(nullptr);
+          mu_quit_note("game thread: closing the renderer"); renderer.reset();
+          mu_quit_note("game thread: renderer closed"); log("renderer: closed, shader list saved"); }
+    catch (const std::exception& e) { log("renderer: close failed: %s", e.what()); }
+  }
+#endif
+}
+}
+
+int run() {
+  wall_start = Clock::now();
+  Thread thread;
+  s32 priority = 0x2C;
+  svcGetThreadPriority(&priority, CUR_THREAD_HANDLE);
+  // Give the game its own CPU core: the main thread (this one), the sound thread and the graphics
+  // driver's threads stay on the others. Falls back to the default core if the choice is refused.
+  u64 core_mask = 0;
+  svcGetInfo(&core_mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
+  const int here = int(svcGetCurrentProcessorNumber());
+  int game_core = -2;
+  for (int c = 3; c >= 0; --c) if ((core_mask >> c) & 1 && c != here) { game_core = c; break; }
+#ifdef MU_SWITCH_GRAPHICS
+  for (int c = 0; c < 4; ++c) if ((core_mask >> c) & 1 && c != here && c != game_core) { render_core = c; break; }
+#endif
+  Result rc = threadCreate(&thread, game_thread, nullptr, nullptr, 16u << 20, priority, game_core);
+  if (R_FAILED(rc) && game_core != -2) { game_core = -2; rc = threadCreate(&thread, game_thread, nullptr, nullptr, 16u << 20, priority, -2); }
+  if (R_FAILED(rc)) { log("cannot create the game thread: 0x%x", rc); return 1; }
+  log("game thread: 16 MiB stack, priority 0x%x, core %d (process cores 0x%llx, main thread on %d)", priority,
+      game_core, (unsigned long long)core_mask, here);
+  threadStart(&thread);
+  // Watchdog: once a second, note whether the game is still calling the host. A crash ends the
+  // process (the log stops); a hang shows as a call count that stops moving.
+  uint64_t seen = 0;
+  for (int second = 1; R_FAILED(waitSingle(waiterForThread(&thread), 1000000000ull)); ++second) {
+    const uint64_t calls = trace_calls;
+    // A crash ends the log at once. For 30 s after each scene change (a match starting, mostly) a line
+    // every 2 s says how far the game got and what it last asked the host for.
+    if (calls != seen && second % 10 != 0 && second % 2 == 0 && count.retraces - scene_changed_at < 30 * 60)
+      log("trail: %u frames (%u into the scene), last %s", count.retraces, count.retraces - scene_changed_at,
+          (const char*)trace_now);
+    flush_log();
+    if (calls == seen || second % 10 == 0)
+      log("watchdog: %d s, %u frames, host calls %llu (%s), last %s", second, count.retraces,
+          (unsigned long long)calls, calls == seen ? "STALLED" : "moving", (const char*)trace_now);
+#ifdef MU_SWITCH_GRAPHICS
+    // A black-screen launch: the game waits on drawing, and drawing waits on the screen.
+    if (calls == seen) {
+      uint64_t commands = 0, draws = 0, vertices = 0; uint32_t copies = 0;
+      gx::stats(&commands, &draws, &vertices, &copies);
+      log("watchdog: render thread is %s; game thread is %s (inside GX decoding: %s, %u bytes; decoded so far: "
+          "%llu commands, %llu draws, %u copies)", mu_render_stage_now(), mu_game_wait_now(), in_fifo ? "yes" : "no",
+          (unsigned)fifo_call_bytes, (unsigned long long)commands, (unsigned long long)draws, copies);
+      if (const uint64_t ms = mu_swap_blocked_ms(); ms > 1500)
+        log("watchdog: the screen has not taken a frame for %llu ms (%llu frames shown so far): the display is "
+            "still held by the app before this one", (unsigned long long)ms, (unsigned long long)mu_swaps());
+    }
+#endif
+    seen = calls;
+  }
+  threadClose(&thread);
+  const int result = game_result;
+  trace_flush_pending();
+  log("game ended: code %d after %u retraces (%.1f s of game time)", result, count.retraces,
+      double(count.retraces) / 60.0);
+  return result;
+}
+
+void shutdown() {
+  for (int port = 0; port < 4; ++port) h_pad_rumble(port, 0);   // no controller left buzzing
+  mu_quit_note("main: stopping sound");
+  stop_sound();
+  save_pack_settings();
+  if (pack_file) { std::fclose(pack_file); pack_file = nullptr; }
+  ax::set_output_sink(nullptr);
+  ax::set_memory({});
+  stop_disc_thread();   // before the image closes: a read may still be running
+  if (disc_file) { std::fclose(disc_file); disc_file = nullptr; }
+  if (log_file) { std::fclose(log_file); log_file = nullptr; }
+}
