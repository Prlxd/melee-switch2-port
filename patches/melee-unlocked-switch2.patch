+// MU_GAME_OPTION_TE switches it on, VS Mode > Tournament Melee becomes its settings menu, and that
+// menu's two words are kept in sdmc:/switch/melee/te-settings.txt. Word 2's upper bits are this port's own.
+bool te_mode = false;
+bool slippi_mode = false;   // the picker's Slippi option: vanilla Melee with Slippi's menus and replays
+constexpr uint32_t kTeWord1 = 0x00007FE0u;
+constexpr uint32_t kTeWord2 = ~(MU_GAME_OPTION2_TAP_JUMP_OFF | MU_GAME_OPTION2_TE_20XX_CPUS | MU_GAME_OPTION2_STADIUM_FROZEN |
+                                MU_GAME_OPTION2_ARCADE_PACK | MU_GAME_OPTION2_TE_LCANCEL_WHEELS | 0xBC000000u);
