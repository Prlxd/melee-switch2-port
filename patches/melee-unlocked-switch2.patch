+float h_one_f32() { return 1.0f; }
+#ifdef MU_SWITCH_GRAPHICS
+// sdmc:/melee/config.ini, one "key=value" per line:
+//   widescreen=1   True 16:9 (more of the stage to each side), 0 for the original 4:3 picture
+//   scale=2        internal resolution: 1 = 640x528 (original), 2 = 1280x1056, 3 = 1920x1584
+#define RUMBLE_HELP "# rumble: controller rumble. 0 = off, 50 = normal, 100 = strongest (Melee's own per-player Rumble option also applies)\n"
+// Opens config.ini to add a setting at the end, first ending the last line if the file doesn't end
+// with one (a value typed in by hand with no line break after it would otherwise run into ours).
+FILE* config_append() {
+  bool ends_open = false;
+  if (FILE* r = std::fopen("sdmc:/melee/config.ini", "rb")) {
+    if (std::fseek(r, -1, SEEK_END) == 0) { const int c = std::fgetc(r); ends_open = c != '\n' && c != EOF; }
+    std::fclose(r);
+  }
+  FILE* a = std::fopen("sdmc:/melee/config.ini", "a");
+  if (a && ends_open) std::fputc('\n', a);
+  return a;
+}
+#define LOGGING_HELP "# logging: 1 = write boot.log, gl.log and launches.txt to this folder (for reporting a problem), 0 = no logs\n"
+#define CPU_20XX_HELP "# cpu20xx: CPUs play with the 20XX AI. 1 = only in 20XX Tournament Edition, 2 = always, 0 = never\n"
+void load_settings() {
+  bool seen_tap_jump = false, seen_cpu_20xx = false, seen_logging = false, seen_rumble = false;
+  if (FILE* f = std::fopen("sdmc:/melee/config.ini", "r")) {
+    char line[256];
+    while (std::fgets(line, sizeof line, f)) {
+      char key[64]; double number = 0;
+      if (std::sscanf(line, " %63[a-z_0-9] = %lf", key, &number) != 2) continue;
+      const int value = int(number);
+      if (!std::strcmp(key, "widescreen")) {}   // always 16:9 with the menu layers stretched (the old setting is ignored)
+      else if (!std::strcmp(key, "scale")) settings.scale = std::clamp(std::round(number * 4) / 4, 1.0, 4.0);   // steps of 0.25
+      else if (!std::strcmp(key, "logging")) seen_logging = true;
+      else if (!std::strcmp(key, "rumble")) { settings.rumble = std::clamp(value, 0, 100); seen_rumble = true; }
+      else if (!std::strcmp(key, "tapjump")) { settings.tap_jump = value != 0; seen_tap_jump = true; }
+      else if (!std::strcmp(key, "cpu20xx")) { settings.cpu_20xx = std::clamp(value, 0, 2); seen_cpu_20xx = true; }
+    }
+    std::fclose(f);
+    // Settings added after the file was made are appended with their defaults, so they can be found.
+    if (!seen_rumble) if (FILE* a = config_append()) {
+      std::fputs(RUMBLE_HELP "rumble=0\n", a);
+      std::fclose(a);
+    }
+    if (!seen_logging) if (FILE* a = config_append()) {
+      std::fputs(LOGGING_HELP "logging=0\n", a);
+      std::fclose(a);
+    }
+    if (!seen_tap_jump) if (FILE* a = config_append()) {
+      std::fputs("# tapjump: 1 = pushing the stick up jumps (normal), 0 = only X/Y jump\ntapjump=1\n", a);
+      std::fclose(a);
+    }
+    if (!seen_cpu_20xx) if (FILE* a = config_append()) {
+      std::fputs(CPU_20XX_HELP "cpu20xx=1\n", a);
+      std::fclose(a);
+    }
+  } else if (FILE* f = std::fopen("sdmc:/melee/config.ini", "w")) {
+    std::fputs("# Melee (Switch 2 Port) settings. Delete this file to get the defaults back.\n"
+
+               "# scale: internal resolution, 1 = original 640x528, 1.5 = 960x792, 2 = 1280x1056, 3 = 1920x1584\n"
+               "scale=2\n"
+               "# tapjump: 1 = pushing the stick up jumps (normal), 0 = only X/Y jump\n"
+               "tapjump=1\n"
+               CPU_20XX_HELP "cpu20xx=1\n"
+               "# boot: which game starts. ask = pick each time, normal, te (20XX Tournament Edition)\n"
+               "# (with a default set, press L just after launching to get the picker back)\n"
+               "boot=ask\n"
+               RUMBLE_HELP "rumble=0\n"
+               LOGGING_HELP "logging=0\n"
+               "# crashtrail: 1 = also record what ran just before a crash (slows the game; turns logging on)\n"
+               "crashtrail=0\n", f);
+    std::fclose(f);
+  }
+}
+float h_picture_widen() { return gx::true_widescreen_active() ? 1.0f / gx::true_widescreen_factor() : 1.0f; }
+// The 20XX Hack Pack's debug menu switches the Tournament Melee features the pack also has (L-cancel
+// flash, collision bubbles, color overlays, ...): host command 0xF8, two feature words. Only the
+// pack's share goes to the game, which accepts it with the pack loaded (mu_te.c), and it is kept in
+// sdmc:/melee/20xx-te.txt between launches.
+constexpr uint32_t kHpTeOptions = MU_GAME_OPTION_TE_NO_STAR_KO | MU_GAME_OPTION_TE_TAUNT_CANCEL |
+                                  MU_GAME_OPTION_TE_FIXED_CAMERA;
+constexpr uint32_t kHpTeOptions2 = MU_GAME_OPTION2_TE_NO_SCREEN_RUMBLE | MU_GAME_OPTION2_TE_LCANCEL_FLASH |
+                                   0x00780000u |   // the flash choices (mu_lcancel_flash.h)
+                                   MU_GAME_OPTION2_TE_BUBBLES | MU_GAME_OPTION2_TE_INPUT_DISPLAY |
+                                   MU_GAME_OPTION2_TE_COLOR_OVERLAYS;
+// 20XX Tournament Edition (the port's native rewrite of it, shim/mu_te*.c) runs on the normal disc:
+// MU_GAME_OPTION_TE switches it on, VS Mode > Tournament Melee becomes its settings menu, and that
+// menu's two words are kept in sdmc:/melee/te-settings.txt. Word 2's upper bits are this port's own.
+bool te_mode = false;
+constexpr uint32_t kTeWord1 = 0x00007FE0u;
+constexpr uint32_t kTeWord2 = ~(MU_GAME_OPTION2_TAP_JUMP_OFF | MU_GAME_OPTION2_TE_20XX_CPUS | MU_GAME_OPTION2_STADIUM_FROZEN |
+                                MU_GAME_OPTION2_ARCADE_PACK | MU_GAME_OPTION2_TE_LCANCEL_WHEELS | 0xBC000000u);
+uint32_t te_w1 = 0, te_w2 = 0;
+bool te_loaded = false;
+bool hp_te_words() { return pack_file != nullptr && !te_mode; }
+uint32_t te_mask1() { return te_mode ? kTeWord1 : hp_te_words() ? kHpTeOptions : 0u; }
+uint32_t te_mask2() { return te_mode ? kTeWord2 : hp_te_words() ? kHpTeOptions2 : 0u; }
+const char* te_words_path() { return te_mode ? "sdmc:/melee/te-settings.txt" : "sdmc:/melee/20xx-te.txt"; }
+void load_te_words() {
+  te_loaded = true;
+  if (FILE* f = std::fopen(te_words_path(), "r")) {
+    unsigned a = 0, b = 0;
+    if (std::fscanf(f, "%x %x", &a, &b) == 2) { te_w1 = a & te_mask1(); te_w2 = b & te_mask2(); }
+    std::fclose(f);
+  }
+}
+void save_te_words() {
+  if (FILE* f = std::fopen(te_words_path(), "w")) {
+    std::fprintf(f, "%08X %08X\n", unsigned(te_w1), unsigned(te_w2));
+    std::fclose(f);
+  }
+}
