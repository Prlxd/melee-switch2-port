+#ifdef __SWITCH__   // newlib has no timegm: days since 1970 from the civil date (UTC)
+inline time_t timegm(struct tm* t) {
+  long long y = t->tm_year + 1900LL, m = t->tm_mon + 1;
+  y -= m <= 2; const long long era = (y >= 0 ? y : y - 399) / 400; const long long yoe = y - era * 400;
+  const long long doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + t->tm_mday - 1;
+  const long long days = era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468;
+  return time_t(days * 86400 + t->tm_hour * 3600LL + t->tm_min * 60LL + t->tm_sec);
+}
+#endif
