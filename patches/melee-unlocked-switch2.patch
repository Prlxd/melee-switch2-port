+    std::error_code size_ec;
+    if (std::filesystem::file_size(MU_LOG_DIR "/launches.txt", size_ec) > 65536 && !size_ec) std::filesystem::remove(MU_LOG_DIR "/launches.txt", size_ec);
+  }
