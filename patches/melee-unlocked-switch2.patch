+  char title[65]{}; std::memcpy(title, disc_header.data() + 0x20, 64);
+  log("disc: \"%s\", NTSC 1.02, %zu filesystem entries, %llu bytes%s", title, files.size(), (unsigned long long)disc_size,
+      files.size() == 1212 ? "" : " (not the vanilla file set: a modded disc)");
+  if (paths.count("/ai_engine.bin") || files.size() != 1212)
+    log("disc: this looks like a modded disc (20XX or another pack); the Source Port runs its own code, so the "
+        "pack's own patches do not run, only its replaced files are read");
+  return true;
+}
+
+
+// sdmc:/switch/melee/20xx.iso: checked for the pack's own files (its stage swap table and its code carrying
+// character select file) and laid over the retail disc. Anything else there runs the normal game.
+std::string pack_settings_path() { return MU_SD_DIR "/20xx-settings.txt"; }
+void load_pack(const std::string& path) {
+  FILE* f = std::fopen(path.c_str(), "rb");
+  if (!f) { log("20xx: cannot open %s; running the normal game", path.c_str()); return; }
+  std::setvbuf(f, nullptr, _IOFBF, 256 << 10);
+  auto at = [&](uint64_t offset, void* out, size_t bytes) {
+    return fseeko(f, off_t(offset), SEEK_SET) == 0 && std::fread(out, 1, bytes, f) == bytes;
+  };
+  auto reject = [&](const char* why) { log("20xx: %s %s; running the normal game", path.c_str(), why); std::fclose(f); };
+  uint8_t header[0x440];
+  if (!at(0, header, sizeof header) || std::memcmp(header, "GALE01", 6)) return reject("is not a Melee (GALE01) disc");
+  const uint32_t fst_offset = be32(header + 0x424), fst_size = be32(header + 0x428);
+  if (fst_size < 12 || fst_size > (16u << 20)) return reject("has an invalid filesystem table");
+  std::vector<uint8_t> fst(fst_size);
+  if (!at(fst_offset, fst.data(), fst.size())) return reject("has an unreadable filesystem table");
+  const uint32_t entries = be32(fst.data() + 8);
+  if (fst[0] != 1 || !entries || uint64_t(entries) * 12 > fst.size()) return reject("has an invalid filesystem root");
+  struct Entry { std::string path; uint32_t start, length; };
+  std::vector<Entry> pack;
+  std::vector<std::pair<uint32_t, std::string>> directories{{entries, ""}};
+  for (uint32_t i = 1; i < entries; ++i) {
+    while (directories.size() > 1 && i >= directories.back().first) directories.pop_back();
+    const uint8_t* entry = fst.data() + size_t(i) * 12;
+    const uint64_t name_at = uint64_t(entries) * 12 + (be32(entry) & 0xFFFFFFu);
+    if (name_at >= fst.size()) return reject("has an invalid filename");
+    const char* name = reinterpret_cast<const char*>(fst.data() + name_at);
+    const char* end = static_cast<const char*>(std::memchr(name, 0, fst.size() - size_t(name_at)));
+    if (!end) return reject("has an invalid filename");
+    std::string full = directories.back().second + "/" + std::string(name, end);
+    std::transform(full.begin(), full.end(), full.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+    if (entry[0]) { directories.push_back({be32(entry + 8), full}); continue; }
+    pack.push_back({full, be32(entry + 4), be32(entry + 8)});
+  }
+  const Entry* table = nullptr; bool second = false;
+  for (const auto& e : pack) {
+    if (source_port::hackpack::is_pack_marker(e.path)) table = &e;
+    if (source_port::hackpack::is_pack_second_marker(e.path)) second = true;
+  }
+  if (!table || !second) return reject("is not a 20XX Hack Pack disc (no StageSwapTable.bin / MnSlChr.0sd)");
+  pack_file = f;
+  pack_base = (disc_size + 0xFFFFFull) & ~0xFFFFFull;
+  uint64_t next = pack_base;
+  size_t replaced = 0, added = 0, kept = 0;
+  for (const auto& e : pack) {
+    if (source_port::hackpack::keeps_retail(e.path)) { ++kept; continue; }
+    if (next + e.length > 0xFFFFFFFFull) { log("20xx: no room for %s; the retail file is used", e.path.c_str()); continue; }
+    pack_ranges.push_back({next, e.length, e.start});
+    const File file{uint32_t(next), e.length, false};
+    if (auto found = paths.find(e.path); found != paths.end()) { files[found->second] = file; ++replaced; }
+    else { paths.emplace(e.path, int32_t(files.size())); files.push_back(file); ++added; }
+    next = (next + e.length + 31) & ~uint64_t(31);
+  }
+  source_port::hackpack::attach(path, table->start, table->length);
+  if (FILE* sf = std::fopen(pack_settings_path().c_str(), "r")) {
+    char text[256] = {};
+    if (std::fgets(text, sizeof text, sf)) {
+      std::string t(text);
+      while (!t.empty() && (t.back() == '\n' || t.back() == '\r')) t.pop_back();
+      source_port::hackpack::settings_parse(t);
+    }
+    std::fclose(sf);
+  }
+  log("20xx: 20XX Hack Pack loaded from %s: %zu files replaced, %zu added, %zu kept retail (its code and menus); "
+      "its features run as the Source Port's native rewrites", path.c_str(), replaced, added, kept);
+}
+void save_pack_settings() {
+  static uint32_t saved = 0;
+  if (!source_port::hackpack::loaded()) return;
+  const uint32_t now = source_port::hackpack::settings().changes.load();
+  if (now == saved) return;
+  saved = now;
+  if (FILE* f = std::fopen(pack_settings_path().c_str(), "w")) {
+    std::fprintf(f, "%s\n", source_port::hackpack::settings_text().c_str());
+    std::fclose(f);
+  }
+}
+
+// Builds Slippi's menu files and lays them over the disc's. All or nothing: a file that cannot be
+// built leaves every menu the disc's own (the game then shows no Slippi menus, as it was told).
+void load_slippi_menus() {
+  std::vector<SysFile> built;
+  uint64_t next = kSlippiSysBase;
+  std::vector<std::pair<std::string, File>> entries;
+  for (const SlippiSysFile& sf : slippi_sys_files) {
+    std::vector<uint8_t> raw(sf.raw_size);
+    uLongf size = uLongf(raw.size());
+    if (uncompress(raw.data(), &size, sf.data, uLong(sf.size)) != Z_OK || size != raw.size()) {
+      log("slippi menus: off (%s does not unpack)", sf.name); return;
+    }
+    std::string path = std::string("/") + sf.name;
+    std::transform(path.begin(), path.end(), path.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+    std::vector<uint8_t> data;
+    if (sf.diff) {
+      const auto found = paths.find(path);
+      if (found == paths.end() || files[found->second].directory) { log("slippi menus: off (%s is not on the disc)", sf.name); return; }
+      const File& disc = files[found->second];
+      std::vector<uint8_t> source(disc.length);
+      if (!read_disc(disc.start, source.data(), source.size())) { log("slippi menus: off (%s unreadable)", sf.name); return; }
+      std::string err;
+      if (!host::vcdiff_decode(source.data(), source.size(), raw.data(), raw.size(), data, &err)) {
+        log("slippi menus: off (%s.diff: %s)", sf.name, err.c_str()); return;
+      }
+    } else {
+      data = std::move(raw);
+    }
+    // Slippi 3.7.0: assets the file links to on the player's disc are copied in (slippi_hsd_links.h).
+    std::string link_error;
+    const auto linked = slippi::hsd::resolve_links(sf.name, data, [](const std::string& name, std::vector<uint8_t>* out) {
+      std::string p = "/" + name;
+      std::transform(p.begin(), p.end(), p.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+      const auto f = paths.find(p);
+      if (f == paths.end() || files[f->second].directory) return false;
+      out->resize(files[f->second].length);
+      return read_disc(files[f->second].start, out->data(), out->size());
+    }, &link_error);
+    if (linked == slippi::hsd::Status::Failed) { log("slippi menus: off (%s links: %s)", sf.name, link_error.c_str()); return; }
+    entries.push_back({path, File{uint32_t(next), uint32_t(data.size()), false}});
+    built.push_back({next, std::move(data)});
+    next = (next + built.back().data.size() + 0x10000 + 31) & ~uint64_t(31);
+  }
+  size_t replaced = 0, added = 0;
+  for (const auto& e : entries) {
+    if (auto found = paths.find(e.first); found != paths.end()) { files[found->second] = e.second; ++replaced; }
+    else { paths.emplace(e.first, int32_t(files.size())); files.push_back(e.second); ++added; }
+  }
+  sys_files = std::move(built);
+  slippi_menus_on = true;
+  log("slippi menus: on, %zu menu files replaced, %zu added", replaced, added);
+}
