+static int lab_command(unsigned int cmd)
+{
+    static unsigned char response[4096];   /* the host's minimum response capacity */
+    unsigned int got = 0;
+    return mu_online_abi_command(cmd, NULL, 0, response, sizeof response, &got);
+}
