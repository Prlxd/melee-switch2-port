+// Threads for the renderer-side code (gx_core.cpp's vertex worker): created like the game and render
+// threads (libnx threadCreate on a given core, big stack). The boot failures of builds 89-96 turned
+// out to be the mutex/condition-variable hand-over, not the thread itself (see gx_core.cpp).
+extern "C" void* mu_thread_start(void (*entry)(void*), void* arg, int core, size_t stack) {
+  Thread* t = new Thread{};
+  s32 priority = 0x2C;
+  svcGetThreadPriority(&priority, CUR_THREAD_HANDLE);
+  if (R_FAILED(threadCreate(t, entry, arg, nullptr, stack, priority, core))) { delete t; return nullptr; }
+  if (R_FAILED(threadStart(t))) { threadClose(t); delete t; return nullptr; }
+  return t;
+}
+extern "C" void mu_thread_join(void* handle) {
+  Thread* t = static_cast<Thread*>(handle);
+  threadWaitForExit(t); threadClose(t); delete t;
+}
+namespace { void set_config_value(const char* key, const char* value); std::string config_value(const char* key); }   // config.ini, defined below main
+namespace host { extern double g_switch_sim_costs[]; }
