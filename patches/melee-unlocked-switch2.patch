+// A mod can draw a perspective HUD before the world. Prefer a fighter's camera so that HUD
+// neither receives temporal scene filtering nor follows the world's sub-frame camera motion.
+inline const DrawCall* frame_scene_draw(const Frame& f) {
+  const DrawCall* fallback = nullptr;
+  for (const auto& d : f.draws) {
+    if (d.xf_regs[0x26] != 0) continue;
+    if (!fallback) fallback = &d;
+    if (d.owner_player < 6 && d.skinned) return &d;
+  }
+  return fallback;
+}
+
+// "Visual effects" (Reduced / Minimal): whether a draw is decoration the player chose to skip. Only
+// during a match, so menus are never touched: an earlier version applied everywhere and hid the
+// stage select pointer and menu text, which are drawn the same way as a hit spark. Only blended
+// draws of the world camera that do not write depth qualify, so fighters, the stage and the HUD
+// always draw. Reduced skips additive ones (glow, sparks, flashes); Minimal also skips any that
+// neither write nor test depth (screen overlays in the world). Display only: guest memory is
+// untouched, so it cannot desync and two players may use different levels.
+//
+// "Of the world camera" is the projection the fighters are drawn with. A HUD drawn in perspective
+// has a camera of its own, and text from the game's text library neither tests nor writes depth:
+// without this test Minimal removed a mod's song title banner text and left its empty backing.
+// owner_player of a draw made by a particle dispatcher (class 8, no user data).
+constexpr uint8_t kEffectOwner = 0xFE;
+constexpr uint8_t kModelEffectOwner = 0xFC; // class-8 EF_Effect objects with their own GObj
+constexpr uint8_t kGameplayOwner = 0xFD;   // items/projectiles and model effects (shields, reflectors)
+struct EffectsFilter {
+  int level = 0;                // 0 = nothing is skipped this frame
+  uint32_t projection[6] = {};  // XF 0x1020..0x1025 of the world camera
+};
+inline EffectsFilter effects_filter(const Frame& f, int level) {
+  EffectsFilter e;
+  if (level <= 0 || !frame_in_match(f)) return e;
+  const DrawCall* scene = frame_scene_draw(f);
+  if (!scene) return e;
+  std::memcpy(e.projection, &scene->xf_regs[0x20], sizeof e.projection);
+  e.level = level;
+  return e;
+}
+inline bool skip_for_effects(const EffectsFilter& e, const DrawCall& dc) {
+  if (dc.owner_player == kGameplayOwner || dc.owner_player < 6) return false;
+  if (e.level <= 0 || dc.xf_regs[0x26] != 0 || !(dc.bp.blendmode() & 1)) return false;
+  const uint32_t zmode = dc.bp.zmode();
+  if (zmode & 0x10) return false;                                   // writes depth: part of the scene
+  if (std::memcmp(e.projection, &dc.xf_regs[0x20], sizeof e.projection) != 0) return false;   // another camera
+  const bool additive = ((dc.bp.blendmode() >> 5) & 7) == 1;         // destination factor ONE
+  // A fighter's model effects: the shield bubble and reflectors blend over the scene and always
+  // stay. No decorative particles also drops the additive glows of moves (Mario's tornado swirl),
+  // which kept drawing at that level.
+  if (dc.owner_player == kModelEffectOwner) return e.level >= 3 && additive;
+  if (additive || (e.level >= 2 && !(zmode & 1))) return true;
+  // No decorative particles (3): every other blended draw of the particle dispatchers as well, the
+  // smoke and dust that Reduced keeps and that can cover a fighter. Fighters with their shields,
+  // items (projectiles) and the stage do not carry that token and stay.
+  return e.level >= 3 && dc.owner_player == kEffectOwner;
+}
+
+// A fighter draw with its colour overlay on (hit flashes, charge glow, invincibility blink): ftMaterial
+// appends one last TEV stage after the material's own, either the light overlay CPREV + colour * RASA
+// (ftMaterial_800BF534) or the colour overlay lerp(CPREV, colour, ratio) (ftMaterial_800BF6BC), its
+// inputs a colour register or a constant. False when that stage adds nothing (ratio or colour 0).
+inline bool fighter_overlay_draw(const DrawCall& dc) {
+  if (dc.owner_player >= 6) return false;
+  const int n = (int)dc.bp.numtevstages();
+  const uint32_t cc = dc.bp.tev_color(n);
+  const uint32_t a = (cc >> 12) & 15, b = (cc >> 8) & 15, c = (cc >> 4) & 15, d = cc & 15;
+  auto reg = [](uint32_t sel) { return sel == 2 || sel == 4 || sel == 6 || sel == 14; };   // C0, C1, C2, konst
+  // The value an input of that stage reads (RGB summed, 0..765).
+  auto value = [&](uint32_t sel) -> int {
+    if (sel == 14) {
+      const int k = dc.bp.ksel_kc(n);
+      if (k < 8) return 765 - 96 * k;   // the fixed constants 1, 7/8, ... 1/8
+      if (k >= 12 && k < 16) return dc.tev_kcolors[k - 12][0] + dc.tev_kcolors[k - 12][1] + dc.tev_kcolors[k - 12][2];
+      if (k >= 16 && k < 32) return 3 * dc.tev_kcolors[(k - 16) & 3][(k - 16) >> 2];
+      return 0;
+    }
+    const int r = (int)sel / 2;   // C0 1, C1 2, C2 3
+    return dc.tev_colors[r][0] + dc.tev_colors[r][1] + dc.tev_colors[r][2];
+  };
+  if (a == 15 && reg(b) && c == 11 && d == 0) return value(b) > 6;          // light overlay
+  if (a == 0 && reg(b) && reg(c) && d == 15) return value(c) > 6;           // colour overlay
+  return false;
+}
+
+// One of the scene's effects: a particle, one of the game's effect objects, or an item or model effect
+// (a projectile's glow, the shield bubble) that blends or does not write depth. The path tracer makes
+// the bright ones light the scene (gx_fx_lights.h).
+inline bool scene_effect_draw(const DrawCall& dc) {
+  if (dc.xf_regs[0x26] != 0) return false;   // orthographic: the HUD's
+  const bool particle = dc.rtx.pass == 1;   // MU_RTX_PASS_PARTICLES (abi/mu_rtx_tokens.h)
+  const bool effect_owner = dc.owner_player == kEffectOwner || dc.owner_player == kModelEffectOwner ||
+                            dc.owner_player == kGameplayOwner;
+  if (!particle && !effect_owner) return false;
+  const uint32_t zm = dc.bp.zmode();
+  const bool writes_depth = (zm & 1) && ((zm >> 4) & 1);
+  return (dc.bp.blendmode() & 1) || !writes_depth;
+}
+// The RTX Remix bridge leaves these out of Remix's scene; the renderer composes them, exactly as the
+// game drew them, into the layer laid over Remix's picture (fireballs, sparks, flashes, shields).
+inline bool remix_effect_draw(const DrawCall& dc) { return scene_effect_draw(dc); }
