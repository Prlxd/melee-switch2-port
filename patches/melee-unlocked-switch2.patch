+template<typename T> T ax_read(uint32_t address) {
+  T value{};
+  auto* p = memory_pointer(address, sizeof value);
+  if (!p) h_panic("switch_host", 0, "AX read outside native memory");
+  std::memcpy(&value, p, sizeof value);
+  return value;
+}
+template<typename T> void ax_write(uint32_t address, T value) {
+  auto* p = memory_pointer(address, sizeof value);
+  if (!p) h_panic("switch_host", 0, "AX write outside native memory");
+  std::memcpy(p, &value, sizeof value);
+}
+// ---- sound ----
+// The AX mixer hands over each block (stereo, right then left, at the game's AI rate: 32 kHz, or 48 kHz
+// if the game asks). It is resampled to the console output's 48 kHz and queued; an audio thread keeps
+// four 1024-frame audout buffers playing from the queue, filling with silence when it runs dry. The
+// queue is capped so a stall never leaves seconds of stale sound behind (port/linux does the same).
+constexpr uint32_t out_rate = 48000;
+constexpr uint32_t out_frames = 1024;                 // per audout buffer: 21 ms, 4 KiB
+constexpr size_t queue_cap = out_rate * 15 / 100;     // 150 ms of frames
+std::mutex sound_lock;
+std::deque<int16_t> sound_queue;                      // interleaved L, R at 48 kHz
+std::atomic<bool> sound_running{false};
+Thread sound_thread_handle;
+bool sound_thread_started = false;
+int16_t resample_last[2] = {0, 0};
+double resample_phase = 0;                            // position between the last input frame and the next
+
+void ax_output(const int16_t* rl, uint32_t frames) {
+  ++count.audio_blocks;
+  if (!rl || !frames || !sound_running.load(std::memory_order_relaxed)) return;
+  const double step = double(audio.rate) / double(out_rate);   // input frames per output frame
+  std::vector<int16_t> out;
+  out.reserve(size_t(frames * (double(out_rate) / audio.rate) + 4) * 2);
+  // Linear interpolation from the previous block's last frame through this block.
+  auto sample = [&](int64_t i, int ch) -> int16_t {   // i = -1 is the previous block's last frame
+    if (i < 0) return resample_last[ch];
+    return rl[size_t(i) * 2 + (ch == 0 ? 1 : 0)];     // input is right, left: output left, right
+  };
+  double pos = resample_phase;                        // relative to frame -1
+  while (pos < double(frames)) {
+    const int64_t i0 = int64_t(pos) - 1;
+    const double t = pos - std::floor(pos);
+    for (int ch = 0; ch < 2; ++ch) {
+      const double a = sample(i0, ch), b = sample(i0 + 1, ch);
+      out.push_back(int16_t(std::lround(a + (b - a) * t)));
+    }
+    pos += step;
+  }
+  resample_phase = pos - double(frames);
+  resample_last[0] = rl[size_t(frames - 1) * 2 + 1];
+  resample_last[1] = rl[size_t(frames - 1) * 2];
+  std::lock_guard<std::mutex> lock(sound_lock);
+  sound_queue.insert(sound_queue.end(), out.begin(), out.end());
+  if (sound_queue.size() > queue_cap * 2) sound_queue.erase(sound_queue.begin(), sound_queue.end() - ptrdiff_t(queue_cap));
+}
+
+void sound_thread(void*) {
+  alignas(0x1000) static int16_t memory[4][out_frames * 2];
+  static AudioOutBuffer buffers[4];
+  auto fill = [](AudioOutBuffer& b) {
+    auto* samples = static_cast<int16_t*>(b.buffer);
+    size_t taken = 0;
+    {
+      std::lock_guard<std::mutex> lock(sound_lock);
+      taken = std::min(sound_queue.size(), size_t(out_frames * 2));
+      std::copy(sound_queue.begin(), sound_queue.begin() + ptrdiff_t(taken), samples);
+      sound_queue.erase(sound_queue.begin(), sound_queue.begin() + ptrdiff_t(taken));
+    }
+    std::fill(samples + taken, samples + out_frames * 2, int16_t(0));
+    b.data_size = out_frames * 2 * sizeof(int16_t);
+    b.data_offset = 0;
+  };
+  for (int i = 0; i < 4; ++i) {
+    buffers[i] = {};
+    buffers[i].buffer = memory[i];
+    buffers[i].buffer_size = sizeof memory[i];
+    fill(buffers[i]);
+    audoutAppendAudioOutBuffer(&buffers[i]);
+  }
+  while (sound_running.load()) {
+    AudioOutBuffer* released = nullptr;
+    u32 released_count = 0;
+    if (R_FAILED(audoutWaitPlayFinish(&released, &released_count, 100000000ull)) || !released) continue;
+    fill(*released);
+    audoutAppendAudioOutBuffer(released);
+  }
+}
+
+void start_sound() {
+  Result rc = audoutInitialize();
+  if (R_FAILED(rc)) { log("sound: audout unavailable (0x%x); running silent", rc); return; }
+  rc = audoutStartAudioOut();
+  if (R_FAILED(rc)) { log("sound: cannot start audout (0x%x); running silent", rc); audoutExit(); return; }
+  sound_running = true;
+  s32 priority = 0x2C;
+  svcGetThreadPriority(&priority, CUR_THREAD_HANDLE);
+  rc = threadCreate(&sound_thread_handle, sound_thread, nullptr, nullptr, 64u << 10, priority > 0x10 ? priority - 1 : priority, -2);
+  if (R_FAILED(rc)) { log("sound: cannot create the sound thread (0x%x)", rc); sound_running = false; audoutStopAudioOut(); audoutExit(); return; }
+  threadStart(&sound_thread_handle);
+  sound_thread_started = true;
+  log("sound: audout %u Hz, %u channels", audoutGetSampleRate(), audoutGetChannelCount());
+}
+
+void stop_sound() {
+  if (!sound_thread_started) return;
+  sound_running = false;
+  threadWaitForExit(&sound_thread_handle);
+  threadClose(&sound_thread_handle);
+  sound_thread_started = false;
+  audoutStopAudioOut();
+  audoutExit();
+}
