+++ b/port/switch2/host_switch.cpp
@@ -0,0 +1,1647 @@
+// Switch 2 (kaiHEN NRO) machine services for the native source game.
+// Boot-test stage: memory, disc, timing, audio DSP, memory card and pads; no renderer yet.
+// Derived from port/linux/host_services.cpp.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <switch.h>
+#include <zlib.h>
+#include "launcher_art.h"
+#include "options_art.h"   // the options screen (launcher/options_art.py)
+#define MU_APP_VERSION "0.8.3"
+extern "C" int mu_crumbs_on;   // 1.0 = fully working; also APP_VERSION in the NRO Makefile
+#ifdef MU_SWITCH_GRAPHICS
+#include "gx_shader.h"
+#endif
+#include "mu_host.h"
+#include "hackpack_source.h"
+#include "ax_ucode.h"
+#include "disc_archive.h"
+#ifdef MU_SWITCH_GRAPHICS
+#include "renderer_gl.h"
+#include "gx_host_compat.h"
+#include "compat/SDL.h"
+#endif
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cerrno>
+#include <chrono>
+#include <csetjmp>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <deque>
+#include <filesystem>
+#include <limits>
+#include <memory>
+#include <string>
+#include <thread>
+#include <cmath>
+#include <mutex>
+#include <condition_variable>
+#include <atomic>
+#include <unistd.h>
+#include <unordered_map>
+#include <vector>
+
+// The console's memory, inside the NRO. The NRO loads at 0x08000000 (measured with memprobe), so all
+// of it is below 4 GB and the game's 32-bit pointer slots hold real addresses.
+extern "C" {
+__attribute__((aligned(0x10000))) unsigned char mu_mem1[40u << 20];
+__attribute__((aligned(0x1000))) unsigned char mu_locked_cache[16u << 10];
+int32_t mu_game_entry(const MuHostApi* host, MuGameApi* game);
+extern char __end__[], __data_start[];
+}
+
+// sdmc:/melee/quit.log: each step of quitting, written and closed one line at a time, so a quit that
+// dies part way shows the step it died in (the crash handler does not run under kaiHEN).
+extern "C" uint64_t mu_swap_blocked_ms();   // sdl_egl.cpp
+extern "C" uint64_t mu_swaps();
+extern "C" uint64_t mu_swap_ticks();
+extern "C" const char* mu_render_stage_now();   // presenter_switch.cpp
+extern "C" const char* mu_game_wait_now();
+// config.ini "logging=1" (or crashtrail=1): without it nothing is written to boot.log, gl.log,
+// quit.log or launches.txt. Set first thing in main.
+static bool g_logging = false;
+extern "C" void mu_quit_note(const char* step) {
+  if (!g_logging) return;
+  if (FILE* f = std::fopen("sdmc:/melee/quit.log", "a")) {
+    std::fprintf(f, "%llu ms: %s\n", (unsigned long long)(armTicksToNs(armGetSystemTick()) / 1000000), step);
+    std::fclose(f);
+  }
+}
+namespace { void set_config_value(const char* key, const char* value); }   // config.ini, defined below main
+namespace switch_host {
+void log(const char* format, ...);
+void crumb(unsigned kind, unsigned long value);
+uint64_t image_base();
+uint8_t* memory_pointer(uint32_t address, uint32_t size);
+
+struct Config {
+  std::string iso_path;
+  std::string log_path;
+  std::string card_dir;
+  uint32_t max_frames = 0;
+  bool pace = true;
+  std::string pack_path;   // sdmc:/melee/20xx.iso when present
+  bool tournament_edition = false;   // 20XX Tournament Edition: the normal disc with TE's features on
+};
+
+struct Counters {
+  uint32_t retraces = 0;
+  uint64_t ticks = 0;
+  uint64_t disc_reads = 0;
+  uint64_t disc_bytes = 0;
+  uint64_t fifo_bytes = 0;
+  uint64_t audio_blocks = 0;
+};
+
+namespace {
+const uintptr_t mem1_base = reinterpret_cast<uintptr_t>(mu_mem1);
+constexpr uint32_t mem1_bytes = sizeof mu_mem1;
+constexpr uint64_t ticks_per_frame = MU_TB_HZ / 60;
+constexpr uint32_t aram_bytes = 32u << 20;
+using Clock = std::chrono::steady_clock;
+Config cfg;
+Counters count;
+MuHostApi api{};
+MuGameApi game{};
+FILE* log_file = nullptr;
+FILE* disc_file = nullptr;
+uint64_t disc_size = 0;
+std::array<uint8_t, 0x440> disc_header{};
+std::jmp_buf stop_boundary;
+bool running = false;
+bool initialized = false;
+bool resimulating = false;
+bool stop_requested = false;
+int stop_code = 0;
+uint64_t boot_ticks = 0;
+uint64_t next_retrace = ticks_per_frame;
+Clock::time_point wall_start;
+std::vector<uint8_t> aram;
+int32_t sound = 1, progressive = 0;
+struct File { uint32_t start, length; bool directory; };
+std::vector<File> files;
+std::unordered_map<std::string, int32_t> paths;
+struct Completion { MuDiscDone callback; int32_t result; void* user; };
+std::deque<Completion> completions;
+struct Audio {
+  const uint8_t* buffer = nullptr;
+  uint32_t bytes = 0;
+  uint32_t rate = 32000;
+  uint64_t next = 0;
+  bool running = false, awaiting = false;
+} audio;
+PadState pads[4];
+uint32_t last_scene = 0xFFFFFFFFu;
+uint32_t vi_configures = 0;
+uintptr_t image_lo = 0;
+#ifdef MU_SWITCH_GRAPHICS
+SDL_Window window_handle{};
+std::unique_ptr<gx::Backend> renderer;
+bool renderer_failed = false;
+int render_core = -2;   // chosen in run(): a core other than the game's and the main thread's
+#endif   // the NRO's load address (start of its code mapping), found at start-up
+
+void write_log(const char* format, va_list args) {
+  if (!log_file) return;
+  std::vfprintf(log_file, format, args);
+  std::fputc('\n', log_file);
+  // Not flushed here: a write to the SD card from the game thread can take milliseconds, a frame
+  // hitch for a log line. The watchdog (main thread) flushes once a second, so a crash loses at
+  // most the last second.
+}
+void flush_log() { if (log_file) std::fflush(log_file); }
+
+bool fail(std::string* error, const std::string& message) {
+  if (error) *error = message;
+  return false;
+}
+
+#include "_disc.inc"
+
+[[noreturn]] void stop_now(int code) {
+  stop_code = code;
+  if (running) std::longjmp(stop_boundary, 1);
+  std::abort();
+}
+void request_stop(int code = 0) { stop_requested = true; stop_code = code; }
+void check_stop() { if (stop_requested) stop_now(stop_code); }
+
+uint64_t console_nanoseconds(uint64_t ticks) {
+  return (ticks/MU_TB_HZ)*1000000000ull + (ticks%MU_TB_HZ)*1000000000ull/MU_TB_HZ;
+}
+uint64_t pace_resyncs = 0;
+// How much of each 16.7 ms frame the game thread had left over when it reached the pacing point
+// (its own work plus waiting on the render queue used the rest): the sum and the least, per report.
+double spare_sum_ms = 0, spare_least_ms = 1e9; uint32_t spare_frames = 0;
+void pace_to(uint64_t ticks) {
+  if (!cfg.pace) return;
+  const auto target = wall_start + std::chrono::nanoseconds(console_nanoseconds(ticks));
+  const auto now = Clock::now();
+  // Fallen more than two frames behind real time (a stall: drawing slower than the game, or a
+  // shader build): forget the debt instead of running the game fast until it is paid back, which
+  // is what made the game speed up after a slow patch. A console cannot catch up either.
+  {
+    const double spare = std::chrono::duration<double, std::milli>(target - now).count();
+    spare_sum_ms += spare; spare_least_ms = std::min(spare_least_ms, spare); ++spare_frames;
+  }
+  if (now > target + std::chrono::milliseconds(33)) { wall_start += now - target; ++pace_resyncs; return; }
+  std::this_thread::sleep_until(target);
+}
+
+void pump_events() {
+  if (!appletMainLoop()) request_stop(0);
+  padUpdate(&pads[0]);
+  // + and - together leave the boot test.
+  const u64 held = padGetButtons(&pads[0]);
+  if ((held & HidNpadButton_Plus) && (held & HidNpadButton_Minus) && !stop_requested) {
+    std::remove("sdmc:/melee/quit.log");
+    mu_quit_note("quit: + and - pressed");
+    request_stop(0);
+  }
+  for (int i = 1; i < 4; ++i) padUpdate(&pads[i]);
+  check_stop();
+}
+
+void audio_tick() {
+  if (!audio.running || !audio.buffer || !audio.bytes || audio.awaiting || count.ticks < audio.next) return;
+  const uint64_t period = uint64_t(audio.bytes) * MU_TB_HZ / (uint64_t(audio.rate) * 4);
+  audio.next += std::max<uint64_t>(period, 1);
+  if (audio.next < count.ticks) audio.next = count.ticks + std::max<uint64_t>(period, 1);
+  audio.awaiting = true;
+  if (game.ai_dma_done) game.ai_dma_done();
+}
+
+void take_disc_finished();
+void deliver_completions() {
+  take_disc_finished();
+  auto pending = std::move(completions);
+  completions.clear();
+  for (const auto& completion : pending)
+    if (completion.callback) completion.callback(completion.result, completion.user);
+}
+volatile uint32_t scene_changed_at = 0;
+// "crashtrail=1" in config.ini: every object callback the game is about to run is written to
+// sdmc:/melee/crumbs.bin first (a ring of 64, 16 bytes each, unbuffered). A crash kills the program
+// without a word; the next launch reads the ring into boot.log, and the last entry is the callback
+// that was running. Slow (a card write per callback): for hunting one crash, not for playing.
+std::string config_value_early(const char* key) {
+  std::string value; const size_t n = std::strlen(key);
+  if (FILE* f = std::fopen("sdmc:/melee/config.ini", "r")) {
+    char line[256];
+    while (std::fgets(line, sizeof line, f))
+      if (!std::strncmp(line, key, n) && line[n] == '=') { value = line + n + 1; while (!value.empty() && (value.back() == '\n' || value.back() == '\r' || value.back() == ' ')) value.pop_back(); }
+    std::fclose(f);
+  }
+  return value;
+}
+FILE* crumb_file = nullptr;
+uint32_t crumb_seq = 0;
+void crumbs_report_previous() {
+  FILE* f = std::fopen("sdmc:/melee/crumbs.bin", "rb");
+  if (!f) return;
+  struct Crumb { uint32_t seq, frame, kind, addr; } ring[64]{};
+  const size_t n = std::fread(ring, sizeof(Crumb), 64, f);
+  std::fclose(f);
+  uint32_t top = 0;
+  for (size_t i = 0; i < n; ++i) top = std::max(top, ring[i].seq);
+  if (!top) return;
+  log("crashtrail: the previous run's last callbacks (newest last; kind 1 = update, 2 = draw):");
+  for (uint32_t s = top >= 12 ? top - 11 : 1; s <= top; ++s)
+    for (size_t i = 0; i < n; ++i)
+      if (ring[i].seq == s) log("crashtrail:   #%u frame %u kind %u at +%X", s, ring[i].frame, ring[i].kind, ring[i].addr - 0x08000000u);
+}
+void crumbs_start() {
+  crumb_file = std::fopen("sdmc:/melee/crumbs.bin", "wb");
+  if (!crumb_file) return;
+  std::setvbuf(crumb_file, nullptr, _IONBF, 0);
+  const std::vector<uint8_t> zero(64 * 16, 0);
+  std::fwrite(zero.data(), 1, zero.size(), crumb_file);
+}   // retrace of the last scene change (the watchdog's crash trail)
