+namespace {
+const uintptr_t mem1_base = reinterpret_cast<uintptr_t>(mu_mem1);
+constexpr uint32_t mem1_bytes = sizeof mu_mem1;
+constexpr uint64_t ticks_per_frame = MU_TB_HZ / 60;
+constexpr uint32_t aram_bytes = 32u << 20;
+using Clock = std::chrono::steady_clock;
+Config cfg;
+Counters count;
+MuHostApi api{};
+MuGameApi game{};
+FILE* log_file = nullptr;
+FILE* disc_file = nullptr;
+uint64_t disc_size = 0;
+std::array<uint8_t, 0x440> disc_header{};
+std::jmp_buf stop_boundary;
+bool running = false;
+bool initialized = false;
+bool resimulating = false;
+bool stop_requested = false;
+int stop_code = 0;
+uint64_t boot_ticks = 0;
+uint64_t next_retrace = ticks_per_frame;
+Clock::time_point wall_start;
+std::vector<uint8_t> aram;
+int32_t sound = 1, progressive = 0;
+struct File { uint32_t start, length; bool directory; };
+std::vector<File> files;
+std::unordered_map<std::string, int32_t> paths;
+struct Completion { MuDiscDone callback; int32_t result; void* user; };
+std::deque<Completion> completions;
+struct Audio {
+  const uint8_t* buffer = nullptr;
+  uint32_t bytes = 0;
+  uint32_t rate = 32000;
+  uint64_t next = 0;
+  bool running = false, awaiting = false;
+} audio;
+PadState pads[4];
+uint32_t last_scene = 0xFFFFFFFFu;
+uint32_t vi_configures = 0;
+uintptr_t image_lo = 0;
+#ifdef MU_SWITCH_GRAPHICS
+SDL_Window window_handle{};
+std::unique_ptr<gx::Backend> renderer;
+bool renderer_failed = false;
+int render_core = -2;   // chosen in run(): a core other than the game's and the main thread's
+#endif   // the NRO's load address (start of its code mapping), found at start-up
+
+std::mutex log_mutex;   // lines come from several threads (the game, the texture pack decoders)
+void write_log(const char* format, va_list args) {
+  if (!log_file) return;
+  std::lock_guard<std::mutex> lock(log_mutex);
+  std::vfprintf(log_file, format, args);
+  std::fputc('\n', log_file);
+  // The first 250 lines (the boot) are flushed one by one: a crash at boot otherwise loses up to a
+  // second of lines (build 93: two closes whose logs stopped mid-line, before the cause).
+  static int lines = 0;
+  if (++lines <= 250) std::fflush(log_file);
+  // Not flushed here: a write to the SD card from the game thread can take milliseconds, a frame
+  // hitch for a log line. The watchdog (main thread) flushes once a second, so a crash loses at
+  // most the last second.
+}
+void flush_log() { if (!log_file) return; std::lock_guard<std::mutex> lock(log_mutex); std::fflush(log_file); }
+
+bool fail(std::string* error, const std::string& message) {
+  if (error) *error = message;
+  return false;
+}
+
+#include "_disc.inc"
+
+[[noreturn]] void stop_now(int code) {
+  stop_code = code;
+  if (running) std::longjmp(stop_boundary, 1);
+  std::abort();
+}
+void request_stop(int code = 0) { stop_requested = true; stop_code = code; }
+void check_stop() { if (stop_requested) stop_now(stop_code); }
+
+uint64_t console_nanoseconds(uint64_t ticks) {
+  return (ticks/MU_TB_HZ)*1000000000ull + (ticks%MU_TB_HZ)*1000000000ull/MU_TB_HZ;
+}
+uint64_t pace_resyncs = 0;
+// How much of each 16.7 ms frame the game thread had left over when it reached the pacing point
+// (its own work plus waiting on the render queue used the rest): the sum and the least, per report.
+double spare_sum_ms = 0, spare_least_ms = 1e9; uint32_t spare_frames = 0;
+void pace_to(uint64_t ticks) {
+  if (!cfg.pace) return;
+  const auto target = wall_start + std::chrono::nanoseconds(console_nanoseconds(ticks));
+  const auto now = Clock::now();
+  // Fallen more than two frames behind real time (a stall: drawing slower than the game, or a
+  // shader build): forget the debt instead of running the game fast until it is paid back, which
+  // is what made the game speed up after a slow patch. A console cannot catch up either.
+  {
+    const double spare = std::chrono::duration<double, std::milli>(target - now).count();
+    spare_sum_ms += spare; spare_least_ms = std::min(spare_least_ms, spare); ++spare_frames;
+    // Diagnostic (the hitch at a match's "Ready, GO!"): a frame more than 40 ms late says where this
+    // frame's game-thread time went (queue = waiting for the render thread to take the frame).
+    static double last[9] = {};
+    double now_cost[9], delta[9];
+    for (int i = 0; i < 9; ++i) {
+      now_cost[i] = ::host::g_switch_sim_costs[i];
+      delta[i] = (now_cost[i] >= last[i] ? now_cost[i] - last[i] : now_cost[i]) * 1000.0;
+      last[i] = now_cost[i];
+    }
+    static int slow_logged = 0;
+    if (spare < -40.0 && slow_logged < 40) {
+      ++slow_logged;
+      log("slow game frame: retrace %u, %.1f ms late: disc %.1f, ax %.1f, texsnap %.1f, queue %.1f, record %.1f, gxdecode %.1f (ms)",
+          count.retraces, -spare, delta[0], delta[1], delta[4], delta[5], delta[7], delta[8]);
+    }
+  }
+  if (now > target + std::chrono::milliseconds(33)) { wall_start += now - target; ++pace_resyncs; return; }
+  std::this_thread::sleep_until(target);
+}
+
+void pump_events() {
+  if (!appletMainLoop()) request_stop(0);
+  padUpdate(&pads[0]);
+  // + and - together leave the boot test.
+  const u64 held = padGetButtons(&pads[0]);
+  if ((held & HidNpadButton_Plus) && (held & HidNpadButton_Minus) && !stop_requested) {
+    std::remove(MU_LOG_DIR "/quit.log");
+    mu_quit_note("quit: + and - pressed");
+    request_stop(0);
+  }
+  for (int i = 1; i < 4; ++i) padUpdate(&pads[i]);
+  check_stop();
+}
+
+void audio_tick() {
+  if (!audio.running || !audio.buffer || !audio.bytes || audio.awaiting || count.ticks < audio.next) return;
+  const uint64_t period = uint64_t(audio.bytes) * MU_TB_HZ / (uint64_t(audio.rate) * 4);
+  audio.next += std::max<uint64_t>(period, 1);
+  if (audio.next < count.ticks) audio.next = count.ticks + std::max<uint64_t>(period, 1);
+  audio.awaiting = true;
+  if (game.ai_dma_done) game.ai_dma_done();
+}
+
+void take_disc_finished();
+void deliver_completions() {
+  take_disc_finished();
+  auto pending = std::move(completions);
+  completions.clear();
+  for (const auto& completion : pending)
+    if (completion.callback) completion.callback(completion.result, completion.user);
+}
+volatile uint32_t scene_changed_at = 0;
+// "crashtrail=1" in config.ini: every object callback the game is about to run is written to
+// sdmc:/switch/melee/logs/crumbs.bin first (a ring of 64, 16 bytes each, unbuffered). A crash kills the program
+// without a word; the next launch reads the ring into boot.log, and the last entry is the callback
+// that was running. Slow (a card write per callback): for hunting one crash, not for playing.
+std::string config_value_early(const char* key) {
+  std::string value; const size_t n = std::strlen(key);
+  if (FILE* f = std::fopen(MU_SD_DIR "/config.ini", "r")) {
+    char line[256];
+    while (std::fgets(line, sizeof line, f))
+      if (!std::strncmp(line, key, n) && line[n] == '=') { value = line + n + 1; while (!value.empty() && (value.back() == '\n' || value.back() == '\r' || value.back() == ' ')) value.pop_back(); }
+    std::fclose(f);
+  }
+  return value;
+}
+FILE* crumb_file = nullptr;
+uint32_t crumb_seq = 0;
+void crumbs_report_previous() {
+  FILE* f = std::fopen(MU_LOG_DIR "/crumbs.bin", "rb");
+  if (!f) return;
+  struct Crumb { uint32_t seq, frame, kind, addr; } ring[64]{};
+  const size_t n = std::fread(ring, sizeof(Crumb), 64, f);
+  std::fclose(f);
+  uint32_t top = 0;
+  for (size_t i = 0; i < n; ++i) top = std::max(top, ring[i].seq);
+  if (!top) return;
+  log("crashtrail: the previous run's last callbacks (newest last; kind 1 = update, 2 = draw):");
+  for (uint32_t s = top >= 12 ? top - 11 : 1; s <= top; ++s)
+    for (size_t i = 0; i < n; ++i)
+      if (ring[i].seq == s) log("crashtrail:   #%u frame %u kind %u at +%X", s, ring[i].frame, ring[i].kind, ring[i].addr - 0x08000000u);
+}
+void crumbs_start() {
+  crumb_file = std::fopen(MU_LOG_DIR "/crumbs.bin", "wb");
+  if (!crumb_file) return;
+  std::setvbuf(crumb_file, nullptr, _IONBF, 0);
+  const std::vector<uint8_t> zero(64 * 16, 0);
+  std::fwrite(zero.data(), 1, zero.size(), crumb_file);
+}   // retrace of the last scene change (the watchdog's crash trail)
+
+void sweep_match_started();
+void report_progress() {
+  MuStatePod state{};
+  if (!game.state_snapshot) return;
+  game.state_snapshot(&state);
+  const uint32_t scene = uint32_t(state.scene_major) << 16 | state.scene;
+  if (scene != last_scene) {
+    log("scene: retrace=%u major=%u minor=%u", count.retraces, state.scene_major, state.scene);
+    scene_changed_at = count.retraces;
+    last_scene = scene;
+    // A VS match has begun (scene 2:2). The sweep counts its matches here: the game's own
+    // "match starting" call comes only for the first match after the menus, not for the ones that
+    // follow straight on from the last.
+    if (scene == (2u << 16 | 2u)) sweep_match_started();
+  }
+  if (count.retraces % 600 == 0) {
+    {
+      // Where the game thread's time went besides the game itself, per frame over the interval
+      // (gxdecode includes record and queue; record includes texsnap and observe).
+      static const char* const names[] = {"disc", "ax", "jukebox", "exi", "texsnap", "queue", "observe", "record", "gxdecode"};
+      char line[256]; size_t n = 0;
+      for (int i = 0; i < 9; ++i) {
+        const double ms = ::host::g_switch_sim_costs[i] * 1000.0 / 600.0;
+        if (ms >= 0.01) n += (size_t)std::snprintf(line + n, sizeof line - n, " %s %.2f", names[i], ms);
+        ::host::g_switch_sim_costs[i] = 0;
+      }
+      log("game thread costs per frame (ms):%s", n ? line : " none");
+    }
+    log("alive: retrace=%u disc_reads=%llu disc_MB=%llu fifo_MB=%llu audio_blocks=%llu", count.retraces,
+        (unsigned long long)count.disc_reads, (unsigned long long)(count.disc_bytes >> 20),
+        (unsigned long long)(count.fifo_bytes >> 20), (unsigned long long)count.audio_blocks);
+  }
+#ifdef MU_SWITCH_GRAPHICS
+  if (count.retraces % 600 == 0 && renderer) {
+    uint64_t commands = 0, draws = 0, vertices = 0; uint32_t copies = 0, frames = 0, pipelines = 0, textures = 0;
+    gx::stats(&commands, &draws, &vertices, &copies);
+    renderer->presentation_stats(&frames, &pipelines, &textures);
+    static uint32_t last_frames = 0; static uint64_t last_resyncs = 0; static Clock::time_point last_time = wall_start;
+    const auto now = Clock::now();
+    const double secs = std::max(0.001, std::chrono::duration<double>(now - last_time).count());
+    static unsigned long long last_draw = 0, last_swap = 0; static unsigned last_dropped = 0;
+    const unsigned long long swap = mu_swap_ticks();
+    unsigned long long draw = 0; unsigned dropped = 0;
+    linux_renderer::switch_draw_stats(renderer.get(), &draw, &dropped);
+    const double shown = frames - last_frames;
+    // Per shown frame: the render thread's own work (GL calls, shader builds) and the time it waited
+    // for the screen to take the frame (the GPU finishing, vsync). Work above ~16 ms is the CPU side;
+    // a long wait with little work is the GPU (resolution) or vsync.
+    const double frame_ticks = shown > 0 ? double(draw - last_draw) / shown : 0.0;
+    const double wait_ticks = shown > 0 ? double(swap - last_swap) / shown : 0.0;
+    log("fps: shown %.1f, game %.1f, slowdowns %llu, skipped %u; per frame: render work %.1f ms, waiting for screen %.1f ms",
+        shown / secs, 600.0 / secs, (unsigned long long)(pace_resyncs - last_resyncs), dropped - last_dropped,
+        armTicksToNs(uint64_t(frame_ticks - wait_ticks)) / 1e6, armTicksToNs(uint64_t(wait_ticks)) / 1e6);
+    if (spare_frames)
+      log("game thread: %.1f ms to spare per frame on average, least %.1f ms (below 0 = a late frame)",
+          spare_sum_ms / spare_frames, spare_least_ms);
+    spare_sum_ms = 0; spare_least_ms = 1e9; spare_frames = 0;
+    last_frames = frames; last_resyncs = pace_resyncs; last_time = now; last_draw = draw; last_dropped = dropped; last_swap = swap;
+    log("gx: commands=%llu draws=%llu vertices=%llu efb_copies=%u presented=%u programs=%u textures=%u%s",
+        (unsigned long long)commands, (unsigned long long)draws, (unsigned long long)vertices, copies, frames,
+        pipelines, textures, renderer_failed ? " (renderer stopped)" : "");
+  }
+#endif
+}
