+// Switch controller -> GameCube pad. Port n reads the player n controller (handheld counts as player 1).
+// ---- Shader sweep (config.ini shadersweep=1) ----
+// The game plays itself: every character on every VS stage, four level 9 CPUs at a time, in short
+// timed matches with every item on, items and Pokemon spawned in turn (the game's side is in
+// gmvsmelee.c, itspawn.c, it_279C.c). Every effect gets drawn once, so its shader lands in
+// recipes.bin. Port 1 and 2 inputs are scripted to get through the title, the main menu and the
+// character select; the stage select is skipped (MELEE_TEST_VS_STAGE). Progress is kept in
+// sdmc:/switch/melee/sweep-progress.txt, so an interrupted sweep carries on where it stopped.
+bool g_sweep = false;
+bool g_sweep_requested = false;   // set in main from config.ini, started once the log is open
+constexpr int kSweepStages[] = {0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x10,
+                                0x11, 0x12, 0x13, 0x14, 0x16, 0x17, 0x18, 0x19, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F, 0x20};
+constexpr int kSweepCharacters = 26;   // CharacterKind 0x00..0x19: the cast, Sheik included
+constexpr int kSweepBatches = (kSweepCharacters + 3) / 4;
+constexpr int kSweepTotal = int(sizeof kSweepStages / sizeof kSweepStages[0]) * kSweepBatches;
+int g_sweep_index = 0;          // the match the menus are heading for
+bool g_sweep_css_ready = false; // characters have been picked once, so START alone starts a match
+bool g_sweep_done = false;
+MuMatchOverride g_sweep_match{};
+char g_sweep_stage_text[8] = "";
+void sweep_fill() {
+  const int i = std::min(g_sweep_index, kSweepTotal - 1);
+  const int stage_index = i / kSweepBatches, batch = i % kSweepBatches;
+  g_sweep_match = MuMatchOverride{};
+  g_sweep_match.stage = kSweepStages[stage_index];
+  for (int p = 0; p < 6; ++p) g_sweep_match.players[p].kind = -1;
+  for (int p = 0; p < 4; ++p) {
+    auto& player = g_sweep_match.players[p];
+    player.kind = (batch * 4 + p) % kSweepCharacters;
+    player.cpu = 1; player.cpu_level = 9;
+    player.costume = (stage_index + p) % 4;   // every character has at least four costumes
+  }
+  std::snprintf(g_sweep_stage_text, sizeof g_sweep_stage_text, "%d", g_sweep_match.stage);
+}
+void sweep_start() {
+  g_sweep = true;
+  if (FILE* f = std::fopen(MU_SD_DIR "/sweep-progress.txt", "r")) {
+    int done = 0;
+    if (std::fscanf(f, "%d", &done) == 1 && done > 0 && done < kSweepTotal) g_sweep_index = done;
+    std::fclose(f);
+  }
+  sweep_fill();
+  log("sweep: shader sweep on, %d matches, starting at %d", kSweepTotal, g_sweep_index + 1);
+}
+const MuMatchOverride* h_sweep_match() { return g_sweep ? &g_sweep_match : nullptr; }
+void sweep_match_started() {
+  if (!g_sweep) return;
+  g_sweep_css_ready = true;
+  log("sweep: match %d of %d, stage %d, characters %d %d %d %d", g_sweep_index + 1, kSweepTotal, g_sweep_match.stage,
+      g_sweep_match.players[0].kind, g_sweep_match.players[1].kind, g_sweep_match.players[2].kind, g_sweep_match.players[3].kind);
+  ++g_sweep_index;
+  if (FILE* f = std::fopen(MU_SD_DIR "/sweep-progress.txt", "w")) { std::fprintf(f, "%d\n", g_sweep_index); std::fclose(f); }
+  if (g_sweep_index >= kSweepTotal) g_sweep_done = true;
+  else sweep_fill();
+}
+const char* h_test_getenv(const char* name) {
+  if (g_sweep && name) {
+    if (!std::strcmp(name, "MU_SHADER_SWEEP")) return "1";
+    if (!std::strcmp(name, "MELEE_TEST_VS_STAGE")) return g_sweep_stage_text;
+  }
+  return name ? std::getenv(name) : nullptr;
+}
+// The scripted controllers. Times are frames since the screen appeared.
+void sweep_inputs(MuPadStatus out[4]) {
+  const uint32_t scene = last_scene, f = count.retraces - scene_changed_at;
+  const uint32_t major = scene >> 16, minor = scene & 0xFFFF;
+  // All matches played: back at the character select, switch the sweep off and quit, which also
+  // saves the shader list.
+  static bool finished = false;
+  if (g_sweep_done && !finished && major == 2 && minor == 0 && f > 60) {
+    finished = true;
+    log("sweep: all %d matches played; shadersweep set back to 0", kSweepTotal);
+    std::remove(MU_SD_DIR "/sweep-progress.txt");
+    ::set_config_value("shadersweep", "0");
+    request_stop(0);
+  }
+  for (int port = 0; port < 2; ++port) { out[port] = MuPadStatus{}; out[port].err = 0; }
+  auto pulse = [&](int port, uint16_t button, uint32_t every, uint32_t from) {
+    if (f >= from && (f - from) % every < 4) out[port].button |= button;
+  };
+  constexpr uint16_t A = 0x0100, START = 0x1000;
+  if (major == 0 || major == 0x18) {                 // title screen and the opening movie
+    pulse(0, START, 40, 20);
+  } else if (major == 1) {                           // main menu: down to VS Mode, A, then A on Melee
+    if (f >= 40 && f < 46) out[0].stick_y = -80;
+    if (f >= 70 && f < 74) out[0].button |= A;
+    if (f >= 110 && f < 114) out[0].button |= A;
+  } else if (major == 2 && minor == 0) {             // character select
+    if (g_sweep_done) return;
+    if (!g_sweep_css_ready) {
+      // The game holds both hands on an icon during the sweep (mncharsel.c), so A picks a character;
+      // pressed a few times in case the screen isn't taking input yet.
+      if (f >= 40 && f < 100 && (f - 40) % 20 < 4) { out[0].button |= A; out[1].button |= A; }
+    }
+    pulse(0, START, 30, g_sweep_css_ready ? 30 : 100);
+  } else if (major == 2 && (minor == 1 || minor == 4)) {   // stage select (if shown) and results
+    pulse(0, A, 40, 30);
+  }
+}
+
+void h_pad_read(MuPadStatus out[4]) {
+  if (!out) return;
+  pump_events();
+  std::memset(out, 0, sizeof(MuPadStatus) * 4);
+  for (unsigned port = 0; port < 4; ++port) {
+    auto& pad = out[port];
+    pad.err = -1;
+    if (!padIsConnected(&pads[port])) continue;
+    pad.err = 0;
+    const u64 b = padGetButtons(&pads[port]);
+    auto map = [&](u64 sw, uint16_t gc) { if (b & sw) pad.button |= gc; };
+    map(HidNpadButton_A, 0x0100); map(HidNpadButton_B, 0x0200);
+    map(HidNpadButton_X, 0x0400); map(HidNpadButton_Y, 0x0800);
+    map(HidNpadButton_Plus, 0x1000); map(HidNpadButton_R, 0x0010);   // R = Z
+    map(HidNpadButton_Left, 0x0001); map(HidNpadButton_Right, 0x0002);
+    map(HidNpadButton_Down, 0x0004); map(HidNpadButton_Up, 0x0008);
+    auto axis = [](s32 v) {
+      if (std::abs(v) < 4000) return int8_t(0);
+      return int8_t(std::clamp(int(v) * 80 / 32767, -80, 80));
+    };
+    const HidAnalogStickState l = padGetStickPos(&pads[port], 0), r = padGetStickPos(&pads[port], 1);
+    pad.stick_x = axis(l.x); pad.stick_y = axis(l.y);
+    pad.sub_x = axis(r.x); pad.sub_y = axis(r.y);
+    if (b & HidNpadButton_ZL) { pad.button |= 0x0040; pad.trigger_l = 255; }
+    if (b & HidNpadButton_ZR) { pad.button |= 0x0020; pad.trigger_r = 255; }
+  }
+  if (g_sweep) sweep_inputs(out);
+}
+struct Settings { int widescreen = 2; double scale = 4.0; bool tap_jump = true; int cpu_20xx = 1; int rumble = 0; } settings;
+// Rumble. Melee's motor is on or off (PADControlMotor), so "on" is a steady buzz on both motors of
+// the player's controller. Vibration handles are made once per controller id and style, and a value
+// is sent only when the state changes: the game repeats its commands every frame.
+struct Rumble {
+  HidVibrationDeviceHandle handles[2]{};
+  int count = 0;
+  HidNpadIdType id = HidNpadIdType_No1;
+  u32 style = 0;
+  int on = -1;
+} rumble[4];
+void h_pad_rumble(int32_t port, int32_t on) {
+  if (port < 0 || port > 3) return;
+  Rumble& r = rumble[port];
+  HidNpadIdType id = HidNpadIdType(HidNpadIdType_No1 + port);
+  u32 styles = hidGetNpadStyleSet(id);
+  if (port == 0 && !styles) { id = HidNpadIdType_Handheld; styles = hidGetNpadStyleSet(id); }
+  HidNpadStyleTag style; int count = 2;
+  if (styles & HidNpadStyleTag_NpadFullKey) style = HidNpadStyleTag_NpadFullKey;
+  else if (styles & HidNpadStyleTag_NpadHandheld) style = HidNpadStyleTag_NpadHandheld;
+  else if (styles & HidNpadStyleTag_NpadJoyDual) style = HidNpadStyleTag_NpadJoyDual;
+  else if (styles & HidNpadStyleTag_NpadJoyLeft) { style = HidNpadStyleTag_NpadJoyLeft; count = 1; }
+  else if (styles & HidNpadStyleTag_NpadJoyRight) { style = HidNpadStyleTag_NpadJoyRight; count = 1; }
+  else { r.on = -1; return; }   // nothing connected for this player
+  if (r.id != id || r.style != u32(style) || !r.count) {
+    r = Rumble{};
+    if (R_FAILED(hidInitializeVibrationDevices(r.handles, count, id, style))) {
+      static bool reported = false;
+      if (!reported) { reported = true; log("rumble: this controller's vibration could not be set up"); }
+      return;
+    }
+    r.count = count; r.id = id; r.style = u32(style);
+  }
+  const int want = on && settings.rumble > 0 ? 1 : 0;
+  if (r.on == want) return;
+  r.on = want;
+  HidVibrationValue values[2];
+  for (auto& v : values) {
+    const float strength = settings.rumble / 100.0f;   // 50 is the strength v0.8.3's test build had
+    v.amp_low = want ? 0.9f * strength : 0.0f; v.freq_low = 160.0f;
+    v.amp_high = want ? 0.7f * strength : 0.0f; v.freq_high = 320.0f;
+  }
+  hidSendVibrationValues(r.handles, values, r.count);
+}
+int32_t h_disc_entry(const char* raw) {
+  std::string path = raw ? raw : "";
+  std::transform(path.begin(), path.end(), path.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+  if (path.empty() || path[0] != '/') path.insert(path.begin(), '/');
+  const auto at = paths.find(path);
+  return at == paths.end() ? -1 : at->second;
+}
+int32_t h_disc_file(int32_t entry, uint32_t* start, uint32_t* length) {
+  if (entry <= 0 || size_t(entry) >= files.size() || files[entry].directory || !start || !length) return 0;
+  *start = files[entry].start; *length = files[entry].length;
+  return 1;
+}
+// Disc reads run on their own thread, as the console's drive worked alongside the game: the game
+// asks, keeps drawing its frames, and is told when the data is there (deliver_completions). Read on
+// the game thread instead, a screen that loads the next one in the background (the results screen,
+// a match's first seconds) waited on the SD card. discthread=1 in config.ini turns it on.
+struct DiscJob { uint32_t offset; void* dst; uint32_t size; MuDiscDone done; void* user; };
+std::mutex disc_jobs_mutex;
+std::condition_variable disc_jobs_cv;
+std::deque<DiscJob> disc_jobs;
+std::deque<Completion> disc_finished;   // read on the disc thread, delivered on the game thread
+std::thread disc_thread;
+bool disc_thread_stop = false;
+void disc_worker() {
+  for (;;) {
+    DiscJob job;
+    {
+      std::unique_lock<std::mutex> lock(disc_jobs_mutex);
+      disc_jobs_cv.wait(lock, [] { return disc_thread_stop || !disc_jobs.empty(); });
+      if (disc_thread_stop) return;
+      job = disc_jobs.front();
+    }
+    const bool ok = job.size <= uint32_t(std::numeric_limits<int32_t>::max()) && read_disc(job.offset, job.dst, job.size);
+    if (!ok) log("disc: read %08X+%X failed", job.offset, job.size);
+    std::lock_guard<std::mutex> lock(disc_jobs_mutex);
+    disc_jobs.pop_front();
+    disc_finished.push_back({job.done, ok ? int32_t(job.size) : -1, job.user});
+  }
+}
+void take_disc_finished() {
+  if (!disc_thread.joinable()) return;
+  std::lock_guard<std::mutex> lock(disc_jobs_mutex);
+  while (!disc_finished.empty()) { completions.push_back(disc_finished.front()); disc_finished.pop_front(); }
+}
+void start_disc_thread() {
+  // Off unless discthread=1: tested at 4x, it changed nothing measurable (the results screen's dip
+  // is drawing, not loading), and reading on the game thread is the long-proven way.
+  if (config_value_early("discthread") != "1") return;
+  disc_thread = std::thread(disc_worker);
+  log("disc: reads on their own thread");
+}
+void stop_disc_thread() {
+  if (!disc_thread.joinable()) return;
+  { std::lock_guard<std::mutex> lock(disc_jobs_mutex); disc_thread_stop = true; disc_jobs.clear(); }
+  disc_jobs_cv.notify_all();
+  disc_thread.join();
+}
+void h_disc_read(uint32_t offset, void* dst, uint32_t size, MuDiscDone done, void* user) {
+  ++count.disc_reads;
+  count.disc_bytes += size;
+  if (disc_thread.joinable()) {
+    { std::lock_guard<std::mutex> lock(disc_jobs_mutex); disc_jobs.push_back({offset, dst, size, done, user}); }
+    disc_jobs_cv.notify_one();
+    return;
+  }
+  const bool ok = size <= uint32_t(std::numeric_limits<int32_t>::max()) && read_disc(offset, dst, size);
+  if (!ok) log("disc: read %08X+%X failed", offset, size);
+  completions.push_back({done, ok ? int32_t(size) : -1, user});
+}
