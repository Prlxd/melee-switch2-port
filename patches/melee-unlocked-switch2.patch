+int run() {
+  wall_start = Clock::now();
+  Thread thread;
+  s32 priority = 0x2C;
+  svcGetThreadPriority(&priority, CUR_THREAD_HANDLE);
+  // Give the game its own CPU core: the main thread (this one), the sound thread and the graphics
+  // driver's threads stay on the others. Falls back to the default core if the choice is refused.
+  u64 core_mask = 0;
+  svcGetInfo(&core_mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
+  const int here = int(svcGetCurrentProcessorNumber());
+  int game_core = -2;
+  for (int c = 3; c >= 0; --c) if ((core_mask >> c) & 1 && c != here) { game_core = c; break; }
+#ifdef MU_SWITCH_GRAPHICS
+  for (int c = 0; c < 4; ++c) if ((core_mask >> c) & 1 && c != here && c != game_core) { render_core = c; break; }
+#endif
+  Result rc = threadCreate(&thread, game_thread, nullptr, nullptr, 16u << 20, priority, game_core);
+  if (R_FAILED(rc) && game_core != -2) { game_core = -2; rc = threadCreate(&thread, game_thread, nullptr, nullptr, 16u << 20, priority, -2); }
+  if (R_FAILED(rc)) { log("cannot create the game thread: 0x%x", rc); return 1; }
+  log("game thread: 16 MiB stack, priority 0x%x, core %d (process cores 0x%llx, main thread on %d)", priority,
+      game_core, (unsigned long long)core_mask, here);
+  threadStart(&thread);
+  // Watchdog: once a second, note whether the game is still calling the host. A crash ends the
+  // process (the log stops); a hang shows as a call count that stops moving.
+  uint64_t seen = 0;
+#ifdef MU_SWITCH_GRAPHICS
+  const bool main_decodes = std::getenv("MU_TEXTURE_PACKS") && gx::texpack::main_thread_decodes();
+  if (main_decodes) log("textures: HD pictures are decoded on the main thread");
+#else
+  const bool main_decodes = false;
+#endif
+  // One watchdog second. With HD textures the main thread decodes queued pictures in the meantime
+  // (in turns of up to 20 ms of waiting), checking between them whether the game has ended.
+  auto wait_a_second = [&]() -> bool {   // true: the game thread has ended
+    if (!main_decodes) return R_SUCCEEDED(waitSingle(waiterForThread(&thread), 1000000000ull));
+    const u64 deadline = armGetSystemTick() + armNsToTicks(1000000000ull);
+    for (;;) {
+      if (R_SUCCEEDED(waitSingle(waiterForThread(&thread), 0))) return true;
+      const u64 now = armGetSystemTick();
+      if (now >= deadline) return false;
+#ifdef MU_SWITCH_GRAPHICS
+      gx::texpack::serve(std::min<u64>(armTicksToNs(deadline - now), 20000000ull));
+#endif
+    }
+  };
+  for (int second = 1; !wait_a_second(); ++second) {
+    const uint64_t calls = trace_calls;
+    // A crash ends the log at once. For 30 s after each scene change (a match starting, mostly) a line
+    // every 2 s says how far the game got and what it last asked the host for.
+    if (calls != seen && second % 10 != 0 && second % 2 == 0 && count.retraces - scene_changed_at < 30 * 60)
+      log("trail: %u frames (%u into the scene), last %s", count.retraces, count.retraces - scene_changed_at,
+          (const char*)trace_now);
+    flush_log();
+    if (calls == seen || second % 10 == 0)
+      log("watchdog: %d s, %u frames, host calls %llu (%s), last %s", second, count.retraces,
+          (unsigned long long)calls, calls == seen ? "STALLED" : "moving", (const char*)trace_now);
+#ifdef MU_SWITCH_GRAPHICS
+    // A black-screen launch: the game waits on drawing, and drawing waits on the screen.
+    if (calls == seen) {
+      uint64_t commands = 0, draws = 0, vertices = 0; uint32_t copies = 0;
+      gx::stats(&commands, &draws, &vertices, &copies);
+      log("watchdog: render thread is %s; game thread is %s (inside GX decoding: %s, %u bytes; decoded so far: "
+          "%llu commands, %llu draws, %u copies)", mu_render_stage_now(), mu_game_wait_now(), in_fifo ? "yes" : "no",
+          (unsigned)fifo_call_bytes, (unsigned long long)commands, (unsigned long long)draws, copies);
+      if (const uint64_t ms = mu_swap_blocked_ms(); ms > 1500)
+        log("watchdog: the screen has not taken a frame for %llu ms (%llu frames shown so far): the display is "
+            "still held by the app before this one", (unsigned long long)ms, (unsigned long long)mu_swaps());
+    }
+#endif
+    seen = calls;
+  }
+  threadClose(&thread);
+  const int result = game_result;
+  trace_flush_pending();
+  log("game ended: code %d after %u retraces (%.1f s of game time)", result, count.retraces,
+      double(count.retraces) / 60.0);
+  return result;
+}
+
+void shutdown() {
+  for (int port = 0; port < 4; ++port) h_pad_rumble(port, 0);   // no controller left buzzing
+  mu_quit_note("main: stopping sound");
+  stop_sound();
+  save_pack_settings();
+  if (pack_file) { std::fclose(pack_file); pack_file = nullptr; }
+  ax::set_output_sink(nullptr);
+  ax::set_memory({});
+  stop_disc_thread();   // before the image closes: a read may still be running
+  if (disc_file) { std::fclose(disc_file); disc_file = nullptr; }
+  if (log_file) { std::fclose(log_file); log_file = nullptr; }
+}
+} // namespace switch_host
+
+namespace host {
+void log(const char* format, ...) {
+  char line[4096];
+  va_list args; va_start(args, format); std::vsnprintf(line, sizeof line, format, args); va_end(args);
+  switch_host::log("%s", line);
+}
+} // namespace host
+
+// ---- crash report ----
+// libnx calls __libnx_exception_handler on its own stack when any thread faults. It writes
+// sdmc:/switch/melee/logs/crash.log: the fault, the registers, the frame-pointer chain and every value on the
+// faulting stack that points into the NRO's code, each also as an offset from the NRO's load address
+// (what addr2line needs against meleeboot.elf).
+extern "C" {
+alignas(16) u8 __nx_exception_stack[0x10000];
+u64 __nx_exception_stack_size = sizeof(__nx_exception_stack);
+}
+namespace {
+bool readable(u64 address, u64 size) {
+  MemoryInfo info{}; u32 page = 0;
+  if (R_FAILED(svcQueryMemory(&info, &page, address))) return false;
+  return (info.perm & Perm_R) && address + size <= info.addr + info.size;
+}
+}
+extern "C" void __libnx_exception_handler(ThreadExceptionDump* ctx) {
+  static bool once = false;
+  if (once) svcExitProcess();
+  once = true;
+  FILE* f = std::fopen(MU_LOG_DIR "/crash.log", "w");
+  if (f) {
+    const u64 base = switch_host::image_base();
+    MemoryInfo code{}; u32 page = 0;
+    svcQueryMemory(&code, &page, base);
+    const u64 code_end = base + code.size;
+    auto off = [&](u64 a) { return a >= base && a < code_end ? a - base : ~0ull; };
+    std::fprintf(f, "Melee boot test crash\n");
+    std::fprintf(f, "desc=0x%x esr=0x%x far=0x%llx\n", ctx->error_desc, ctx->esr, (unsigned long long)ctx->far.x);
+    std::fprintf(f, "nro base=0x%llx code_end=0x%llx\n", (unsigned long long)base, (unsigned long long)code_end);
+    std::fprintf(f, "pc=0x%llx (+0x%llx)\nlr=0x%llx (+0x%llx)\nsp=0x%llx fp=0x%llx\n",
+                 (unsigned long long)ctx->pc.x, (unsigned long long)off(ctx->pc.x),
+                 (unsigned long long)ctx->lr.x, (unsigned long long)off(ctx->lr.x),
+                 (unsigned long long)ctx->sp.x, (unsigned long long)ctx->fp.x);
+    for (int i = 0; i < 29; ++i)
+      std::fprintf(f, "x%-2d=0x%016llx%s", i, (unsigned long long)ctx->cpu_gprs[i].x, i % 3 == 2 ? "\n" : "  ");
+    std::fprintf(f, "\nframes (fp chain):\n");
+    u64 fp = ctx->fp.x;
+    for (int i = 0; i < 48 && fp && !(fp & 15) && readable(fp, 16); ++i) {
+      const u64 next = reinterpret_cast<const u64*>(fp)[0], ret = reinterpret_cast<const u64*>(fp)[1];
+      std::fprintf(f, "  #%-2d +0x%llx\n", i, (unsigned long long)off(ret));
+      if (next <= fp) break;
+      fp = next;
+    }
+    std::fprintf(f, "stack values in code:\n");
+    const u64 sp = ctx->sp.x;
+    int found = 0;
+    for (u64 a = sp; a < sp + 0x4000 && found < 64; a += 8) {
+      if (!readable(a, 8)) break;
+      const u64 v = *reinterpret_cast<const u64*>(a);
+      if (off(v) != ~0ull) { std::fprintf(f, "  sp+0x%llx: +0x%llx\n", (unsigned long long)(a - sp), (unsigned long long)off(v)); ++found; }
+    }
+    std::fclose(f);
+  }
+  switch_host::log("CRASH: desc=0x%x pc=0x%llx far=0x%llx (details in crash.log)", ctx->error_desc,
+                   (unsigned long long)ctx->pc.x, (unsigned long long)ctx->far.x);
+  svcExitProcess();
+}
