+int32_t h_slippi(uint8_t command, const uint8_t* p, uint32_t n, uint8_t* out, uint32_t cap, uint32_t* size) {
+  if (size) *size = 0;
+  std::vector<uint8_t> reply;
+  if (command == 0xF8 && (n == 0 || n == 8) && (hp_te_words() || te_mode)) {
+    if (!te_loaded) load_te_words();
+    if (n == 8) {
+      const uint32_t a = uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+      const uint32_t b = uint32_t(p[4]) << 24 | uint32_t(p[5]) << 16 | uint32_t(p[6]) << 8 | p[7];
+      // TE's "Lock settings": while it is on, only switching the lock off goes through.
+      if (te_mode && (te_w2 & MU_GAME_OPTION2_TE_LOCK_SETTINGS)) {
+        if (!(b & MU_GAME_OPTION2_TE_LOCK_SETTINGS)) te_w2 &= ~MU_GAME_OPTION2_TE_LOCK_SETTINGS;
+      } else { te_w1 = a & te_mask1(); te_w2 = b & te_mask2(); }
+      save_te_words();
+      log("20xx: menu options %08X %08X", unsigned(te_w1), unsigned(te_w2));
+    }
+    if (cap < 8 || !out) return n == 8 ? 0 : -2;
+    const uint32_t w[2] = {te_w1 | (te_mode ? MU_GAME_OPTION_TE : 0u), te_w2};
+    for (int i = 0; i < 2; ++i) for (int k = 0; k < 4; ++k) out[i * 4 + k] = uint8_t(w[i] >> (24 - 8 * k));
+    if (size) *size = 8;
+    return 0;
+  }
+  if (command != MU_HP_COMMAND) return -1;
+  if (n >= 1 && p[0] == MU_HP_OP_CPU_WORD) {
+    // The pack's menu asks for the CPU training options; this port keeps none yet (all off).
+    if (source_port::hackpack::loaded()) reply.assign(4, 0);
+  } else {
+    source_port::hackpack::command(p, n, reply, true);
+  }
+  if (reply.size() > cap || (!out && !reply.empty())) return -2;
+  if (!reply.empty()) std::memcpy(out, reply.data(), reply.size());
+  if (size) *size = uint32_t(reply.size());
+  save_pack_settings();
+  return 0;
+}
