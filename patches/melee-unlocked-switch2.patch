+uint32_t te_mask1() { return te_mode ? kTeWord1 : hp_te_words() ? kHpTeOptions : 0u; }
+uint32_t te_mask2() { return te_mode ? kTeWord2 : hp_te_words() ? kHpTeOptions2 : 0u; }
+const char* te_words_path() { return te_mode ? MU_SD_DIR "/te-settings.txt" : MU_SD_DIR "/20xx-te.txt"; }
+void load_te_words() {
+  te_loaded = true;
+  if (FILE* f = std::fopen(te_words_path(), "r")) {
+    unsigned a = 0, b = 0;
+    if (std::fscanf(f, "%x %x", &a, &b) == 2) { te_w1 = a & te_mask1(); te_w2 = b & te_mask2(); }
+    std::fclose(f);
