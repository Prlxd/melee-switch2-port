+// mbedTLS's platform hooks (switch_config.h): entropy from the console's CSPRNG, milliseconds from
+// the system tick.
+extern "C" int mbedtls_hardware_poll(void*, unsigned char* output, size_t len, size_t* olen) {
+  if (R_FAILED(csrngGetRandomBytes(output, len))) { *olen = 0; return -1; }
+  *olen = len;
+  return 0;
+}
+extern "C" mbedtls_ms_time_t mbedtls_ms_time(void) {
+  return mbedtls_ms_time_t(armTicksToNs(armGetSystemTick()) / 1000000ull);
+}
+
+namespace switch_tls {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+// Shared once: the random generator and the parsed roots (parsing 120 certificates takes a moment).
+struct Shared {
+  bool ready = false;
+  std::string error;
+  mbedtls_entropy_context entropy;
+  mbedtls_ctr_drbg_context drbg;
+  mbedtls_x509_crt roots;
+};
+Shared& shared() {
+  static Shared s;
+  static std::once_flag once;
+  std::call_once(once, [] {
+    csrngInitialize();
+    psa_crypto_init();
+    mbedtls_entropy_init(&s.entropy);
+    mbedtls_ctr_drbg_init(&s.drbg);
+    mbedtls_x509_crt_init(&s.roots);
+    static const char kPers[] = "melee-switch2-tls";
+    if (mbedtls_ctr_drbg_seed(&s.drbg, mbedtls_entropy_func, &s.entropy, (const unsigned char*)kPers, sizeof kPers - 1) != 0) {
+      s.error = "no random numbers for TLS"; return;
+    }
+    const int bad = mbedtls_x509_crt_parse(&s.roots, kCaBundle, kCaBundleSize);
+    if (bad < 0) { s.error = "the certificate roots do not parse"; return; }
+    s.ready = true;
+  });
+  return s;
+}
+
+std::string tls_text(int code) {
+  char text[128] = {};
+  mbedtls_strerror(code, text, sizeof text);
+  return text;
+}
+
+int left_ms(Clock::time_point deadline) {
+  const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - Clock::now()).count();
+  return ms < 0 ? 0 : int(ms);
+}
+
+}  // namespace
+
+struct Connection::Impl {
+  int fd = -1;
+  bool secure = false, tls_ready = false;
+  mbedtls_ssl_context ssl;
+  mbedtls_ssl_config conf;
+
+  Impl() { mbedtls_ssl_init(&ssl); mbedtls_ssl_config_init(&conf); }
+  ~Impl() { close(); mbedtls_ssl_free(&ssl); mbedtls_ssl_config_free(&conf); }
+
+  void close() {
+    if (tls_ready) { mbedtls_ssl_close_notify(&ssl); tls_ready = false; }
+    if (fd >= 0) { ::close(fd); fd = -1; }
+  }
+
+  // Waits for the socket; Ok when ready, Timeout at the deadline, Cancelled when asked.
+  Io wait(short events, Clock::time_point deadline, const std::function<bool()>& cancelled) const {
+    for (;;) {
+      if (cancelled && cancelled()) return Io::Cancelled;
+      int left = left_ms(deadline);
+      if (left == 0) return Io::Timeout;
+      if (left > 100) left = 100;   // look at cancelled() every 0.1 s
+      pollfd p{fd, events, 0};
+      const int n = ::poll(&p, 1, left);
+      if (n > 0) return (p.revents & POLLNVAL) ? Io::Error : Io::Ok;
+      if (n < 0 && errno != EINTR) return Io::Error;
+    }
+  }
+
+  static int send_cb(void* ctx, const unsigned char* buf, size_t len) {
+    const int fd = *static_cast<int*>(ctx);
+    const ssize_t n = ::send(fd, buf, len, 0);
+    if (n >= 0) return int(n);
+    return (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) ? MBEDTLS_ERR_SSL_WANT_WRITE : MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+  }
+  static int recv_cb(void* ctx, unsigned char* buf, size_t len) {
+    const int fd = *static_cast<int*>(ctx);
+    const ssize_t n = ::recv(fd, buf, len, 0);
+    if (n > 0) return int(n);
+    if (n == 0) return MBEDTLS_ERR_SSL_CONN_EOF;
+    return (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) ? MBEDTLS_ERR_SSL_WANT_READ : MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+  }
+};
+
+Connection::Connection() : impl_(new Impl) {}
+Connection::~Connection() = default;
+bool Connection::is_open() const { return impl_->fd >= 0; }
+void Connection::close() { impl_->close(); }
+
+Io Connection::open(const std::string& host, uint16_t port, bool secure, int timeout_ms,
+                    const std::function<bool()>& cancelled, std::string* error) {
+  Impl& c = *impl_;
+  c.close();
+  c.secure = secure;
+  const auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
+  addrinfo hints{}; hints.ai_family = AF_INET; hints.ai_socktype = SOCK_STREAM;
+  addrinfo* found = nullptr;
+  const std::string port_text = std::to_string(port);
+  if (getaddrinfo(host.c_str(), port_text.c_str(), &hints, &found) != 0 || !found) {
+    *error = "cannot resolve " + host; return Io::Error;
+  }
+  Io result = Io::Error;
+  for (addrinfo* a = found; a; a = a->ai_next) {
+    c.fd = ::socket(a->ai_family, a->ai_socktype, a->ai_protocol);
+    if (c.fd < 0) continue;
+    ::fcntl(c.fd, F_SETFL, ::fcntl(c.fd, F_GETFL, 0) | O_NONBLOCK);
+    int one = 1; ::setsockopt(c.fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+    if (::connect(c.fd, a->ai_addr, a->ai_addrlen) == 0) { result = Io::Ok; break; }
+    if (errno == EINPROGRESS) {
+      result = c.wait(POLLOUT, deadline, cancelled);
+      int so = 0; socklen_t len = sizeof so;
+      if (result == Io::Ok && ::getsockopt(c.fd, SOL_SOCKET, SO_ERROR, &so, &len) == 0 && so == 0) break;
+      if (result == Io::Ok) result = Io::Error;
+    }
+    ::close(c.fd); c.fd = -1;
+    if (result == Io::Cancelled || result == Io::Timeout) break;
+  }
+  freeaddrinfo(found);
+  if (result != Io::Ok) {
+    if (result == Io::Error) *error = "cannot connect to " + host;
+    else if (result == Io::Timeout) *error = "connecting to " + host + " timed out";
+    return result;
+  }
+  if (!secure) return Io::Ok;
+
+  Shared& s = shared();
+  if (!s.ready) { *error = s.error; c.close(); return Io::Error; }
+  mbedtls_ssl_free(&c.ssl); mbedtls_ssl_config_free(&c.conf);
+  mbedtls_ssl_init(&c.ssl); mbedtls_ssl_config_init(&c.conf);
+  if (mbedtls_ssl_config_defaults(&c.conf, MBEDTLS_SSL_IS_CLIENT, MBEDTLS_SSL_TRANSPORT_STREAM, MBEDTLS_SSL_PRESET_DEFAULT) != 0) {
+    *error = "TLS setup failed"; c.close(); return Io::Error;
+  }
+  mbedtls_ssl_conf_authmode(&c.conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+  mbedtls_ssl_conf_ca_chain(&c.conf, &s.roots, nullptr);
+  mbedtls_ssl_conf_rng(&c.conf, mbedtls_ctr_drbg_random, &s.drbg);
+  static const char* kAlpn[] = {"http/1.1", nullptr};   // the WebSocket upgrade needs HTTP/1.1
+  mbedtls_ssl_conf_alpn_protocols(&c.conf, kAlpn);
+  if (mbedtls_ssl_setup(&c.ssl, &c.conf) != 0 || mbedtls_ssl_set_hostname(&c.ssl, host.c_str()) != 0) {
+    *error = "TLS setup failed"; c.close(); return Io::Error;
+  }
+  mbedtls_ssl_set_bio(&c.ssl, &c.fd, &Impl::send_cb, &Impl::recv_cb, nullptr);
+  for (;;) {
+    const int r = mbedtls_ssl_handshake(&c.ssl);
+    if (r == 0) break;
+    if (r == MBEDTLS_ERR_SSL_WANT_READ || r == MBEDTLS_ERR_SSL_WANT_WRITE) {
+      const Io w = c.wait(r == MBEDTLS_ERR_SSL_WANT_READ ? POLLIN : POLLOUT, deadline, cancelled);
+      if (w == Io::Ok) continue;
+      if (w == Io::Timeout) *error = "TLS handshake with " + host + " timed out";
+      c.close();
+      return w;
+    }
+    const uint32_t flags = mbedtls_ssl_get_verify_result(&c.ssl);
+    *error = "TLS with " + host + ": " + tls_text(r);
+    if (flags && flags != uint32_t(-1)) {
+      char why[256] = {};
+      mbedtls_x509_crt_verify_info(why, sizeof why, "", flags);
+      *error += std::string(" (") + why + ")";
+      while (!error->empty() && (error->back() == '\n' || error->back() == ')')) error->pop_back();
+      *error += ")";
+    }
+    c.close();
+    return Io::Error;
+  }
+  c.tls_ready = true;
+  return Io::Ok;
+}
+
+Io Connection::read(uint8_t* out, size_t size, size_t* got, int timeout_ms, const std::function<bool()>& cancelled) {
+  Impl& c = *impl_;
+  *got = 0;
+  if (c.fd < 0) return Io::Error;
+  const auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
+  for (;;) {
+    if (cancelled && cancelled()) return Io::Cancelled;
+    if (c.secure) {
+      const int r = mbedtls_ssl_read(&c.ssl, out, size);
+      if (r > 0) { *got = size_t(r); return Io::Ok; }
+      if (r == 0 || r == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY || r == MBEDTLS_ERR_SSL_CONN_EOF) return Io::Error;
+      // TLS 1.3: a session ticket arriving is not data; read again.
+      if (r == MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET) continue;
+      if (r != MBEDTLS_ERR_SSL_WANT_READ && r != MBEDTLS_ERR_SSL_WANT_WRITE) return Io::Error;
+      const Io w = c.wait(r == MBEDTLS_ERR_SSL_WANT_READ ? POLLIN : POLLOUT, deadline, cancelled);
+      if (w != Io::Ok) return w;
+    } else {
+      const ssize_t n = ::recv(c.fd, out, size, 0);
+      if (n > 0) { *got = size_t(n); return Io::Ok; }
+      if (n == 0) return Io::Error;
+      if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) return Io::Error;
+      const Io w = c.wait(POLLIN, deadline, cancelled);
+      if (w != Io::Ok) return w;
+    }
+  }
+}
+
+bool Connection::write(const uint8_t* data, size_t size, int timeout_ms) {
+  Impl& c = *impl_;
+  if (c.fd < 0) return false;
+  const auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
+  while (size) {
+    int r;
+    if (c.secure) r = mbedtls_ssl_write(&c.ssl, data, size);
+    else {
+      const ssize_t n = ::send(c.fd, data, size, 0);
+      r = n >= 0 ? int(n) : (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) ? MBEDTLS_ERR_SSL_WANT_WRITE : -1;
+    }
+    if (r > 0) { data += r; size -= size_t(r); continue; }
+    if (r != MBEDTLS_ERR_SSL_WANT_READ && r != MBEDTLS_ERR_SSL_WANT_WRITE) return false;
+    if (c.wait(r == MBEDTLS_ERR_SSL_WANT_READ ? POLLIN : POLLOUT, deadline, nullptr) != Io::Ok) return false;
+  }
+  return true;
+}
+
+}  // namespace switch_tls
diff --git a/port/switch2/tls_switch.h b/port/switch2/tls_switch.h
new file mode 100644
index 0000000..51806ce
--- /dev/null
+++ b/port/switch2/tls_switch.h
@@ -0,0 +1,37 @@
+// TLS client connections for the Switch 2 port (mbedTLS over libnx's BSD sockets): what the PC
+// builds get from Schannel (Windows) or libcurl (Linux, macOS). Used by Slippi 3.7.0's matchmaking
+// (wss://) and HTTPS requests. Certificates are checked against the Mozilla roots (ca_bundle.h).
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+
+namespace switch_tls {
+
+enum class Io { Ok, Timeout, Error, Cancelled };
+
+class Connection {
+ public:
+  Connection();
+  ~Connection();
+  Connection(const Connection&) = delete;
+  Connection& operator=(const Connection&) = delete;
+  // TCP (IPv4) to host:port, then TLS when secure (SNI and certificate check against host, ALPN
+  // http/1.1). cancelled() is polled while connecting.
+  Io open(const std::string& host, uint16_t port, bool secure, int timeout_ms,
+          const std::function<bool()>& cancelled, std::string* error);
+  // Up to `size` bytes into `out`: Ok with *got > 0, Error when closed or broken, Timeout.
+  Io read(uint8_t* out, size_t size, size_t* got, int timeout_ms, const std::function<bool()>& cancelled);
+  bool write(const uint8_t* data, size_t size, int timeout_ms);
+  void close();
+  bool is_open() const;
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace switch_tls
