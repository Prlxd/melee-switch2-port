+void log(const char* format, ...) { va_list args; va_start(args, format); write_log(format, args); va_end(args); }
+void crumb(unsigned kind, unsigned long value) {
+  if (!crumb_file) return;
+  const uint32_t rec[4] = {++crumb_seq, count.retraces, kind, uint32_t(value)};
+  std::fseek(crumb_file, long((crumb_seq % 64) * 16), SEEK_SET);
+  std::fwrite(rec, 1, sizeof rec, crumb_file);
+}
+uint64_t image_base() { return image_lo; }
+bool state_snapshot(MuStatePod* out) { if (!out || !game.state_snapshot) return false; game.state_snapshot(out); return true; }
+uint32_t retraces() { return count.retraces; }
+uint32_t mem1_size_bytes() { return sizeof mu_mem1; }
+
+// GX and AX hand the host console addresses: a cached pointer the game owns (0x08000000 and up on
+// Switch 2), its physical form (that minus 0x80000000, in 32-bit arithmetic: 0x88000000 and up), or
+// its uncached form (plus 0x40000000). Anything outside the NRO's own memory returns nullptr.
+uint8_t* memory_pointer(uint32_t address, uint32_t size) {
+  // The game owns memory from the NRO's load address (0x08000000) to the end of MEM1. GX and AX hand
+  // the host one of: a cached pointer; its physical form (pointer - 0x80000000 in 32-bit arithmetic,
+  // 0x88000000 and up); its uncached form (+0x40000000); or an address rebuilt from a GX register,
+  // which keeps only 26 bits (the console's 64 MB physical space): 0x80000000 | (pointer & 0x03FFFFFF),
+  // or those 26 bits alone. A 26-bit address is resolved inside the 64 MB window that ends at MEM1's
+  // end, which holds all of the game's data (the window is checked at start-up).
+  const uintptr_t mem_end = reinterpret_cast<uintptr_t>(mu_mem1) + sizeof mu_mem1;
+  const uintptr_t window = mem_end - (64u << 20);
+  auto from26 = [&](uint32_t low) { return window + ((uintptr_t(low) - window) & 0x03FFFFFFu); };
+  uintptr_t at = address;
+  if (address < (64u << 20)) at = from26(address);
+  else if (address >= 0x80000000u && address < 0x84000000u) at = from26(address & 0x03FFFFFFu);
+  else if (address >= 0x88000000u && address < 0xC0000000u) at = address - 0x80000000u;
+  else if (address >= 0x48000000u && address < 0x80000000u) at = address - 0x40000000u;
+  const uint64_t end = uint64_t(at) + size;
+  const uintptr_t lo = image_lo, hi = reinterpret_cast<uintptr_t>(__end__);
+  if (at >= lo && end <= hi) return reinterpret_cast<uint8_t*>(at);
+  return nullptr;
+}
+
+bool initialize(const Config& config, std::string* error) {
+  cfg = config; count = {}; game = {}; audio = {}; stop_requested = false; stop_code = 0;
+  resimulating = false; next_retrace = ticks_per_frame; sound = 1; progressive = 0;
+  log_file = g_logging ? std::fopen(cfg.log_path.c_str(), "w") : nullptr;
+  log("Smash Melee Switch 2 v" MU_APP_VERSION " (build 72, threaded graphics + sound, widescreen, 20XX)");
+  // The call trace slows the game to a crawl (a flushed SD write per call): only on request.
+  if (FILE* on = std::fopen("sdmc:/melee/trace.on", "r")) {
+    std::fclose(on);
+    trace_file = std::fopen("sdmc:/melee/trace.log", "w");
+    log("trace: on (sdmc:/melee/trace.on exists)");
+  }
+  {
+    MemoryInfo info{}; u32 page = 0;
+    if (R_SUCCEEDED(svcQueryMemory(&info, &page, reinterpret_cast<u64>(&initialize)))) image_lo = uintptr_t(info.addr);
+  }
+  log("memory: NRO %p-%p, MEM1 %p (%u MiB), locked cache %p", (void*)image_lo, (void*)__end__,
+      (void*)mu_mem1, mem1_bytes >> 20, (void*)mu_locked_cache);
+  {
+
+    const uintptr_t mem_end = reinterpret_cast<uintptr_t>(mu_mem1) + sizeof mu_mem1;
+    log("memory: GX 26-bit window %08lX-%08lX, game data from %p", (unsigned long)(mem_end - (64u << 20)),
+        (unsigned long)mem_end, (void*)__data_start);
+  }
+  if (reinterpret_cast<uintptr_t>(__end__) > 0x40000000u)
+    return fail(error, "NRO did not load below 1 GB; the game's pointers need it there");
+  log("iso: %s", cfg.iso_path.c_str());
+  if (!load_disc(error)) return false;
+  start_disc_thread();
+  te_mode = cfg.tournament_edition;
+  if (!cfg.pack_path.empty() && !te_mode) load_pack(cfg.pack_path);
+  boot_ticks = uint64_t(std::max<int64_t>(0, int64_t(std::time(nullptr)) - 946684800)) * MU_TB_HZ;
+  aram.assign(aram_bytes, 0);
+  api = make_api();
+  if (mu_game_entry(&api, &game) != 0 || game.version != MU_GAME_API_VERSION ||
+      !game.run || !game.retrace || !game.fire_alarms || !game.state_snapshot)
+    return fail(error, "native game/host ABI mismatch");
+  ax::set_memory({ax_read<uint16_t>, ax_read<uint32_t>, ax_write<uint16_t>, ax_write<uint32_t>, aram.data(), aram_bytes});
+  ax::reset(); ax::set_output_sink(ax_output);
+  start_sound();
+  padConfigureInput(4, HidNpadStyleSet_NpadStandard);
+  padInitializeDefault(&pads[0]);
+  for (int i = 1; i < 4; ++i) padInitialize(&pads[i], HidNpadIdType(HidNpadIdType_No1 + i));
+  initialized = true;
+  log("host: API %u/%u, MEM1 %u MiB, ARAM %u MiB; starting the game", api.version, game.version,
+      mem1_bytes >> 20, aram_bytes >> 20);
+  return true;
+}
