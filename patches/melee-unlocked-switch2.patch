+// ---- Rollback savestates (Slippi option) ----
+// The snapshot is the game's capture ranges (its 40 MiB main memory and its own data and bss, the
+// marked blocks of prelink_game.ld) minus its exclusions. The sound driver's files sit outside those
+// blocks, so its state is never restored, as a console savestate leaves it out.
+native_savestate::Engine g_savestates;
+static uint32_t rb_be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+static void rollback_stats(const char* when) {
+  const auto& s = g_savestates.stats();
+  log("online: snapshots %s: %llu captures (avg %.2f ms, max %.2f), %llu loads (avg %.2f ms, max %.2f), %llu missing",
+      when, (unsigned long long)s.captures, s.captures ? s.capture_ms_total / s.captures : 0.0, s.capture_ms_max,
+      (unsigned long long)s.loads, s.loads ? s.load_ms_total / s.loads : 0.0, s.load_ms_max,
+      (unsigned long long)s.missing_loads);
+}
+static void rollback_begin() {
+  std::vector<MuStateRegion> ranges(game.snapshot_ranges(nullptr, 0));
+  game.snapshot_ranges(ranges.data(), uint32_t(ranges.size()));
+  std::vector<MuStateRegion> exclusions(game.state_exclusions(nullptr, 0));
+  game.state_exclusions(exclusions.data(), uint32_t(exclusions.size()));
+  for (const auto& r : ranges) log("online: snapshot range %p +%X", r.address, unsigned(r.size));
+  const uint64_t t0 = armGetSystemTick();
+  g_savestates.begin(native_savestate::subtract(ranges, exclusions), slippi::ROLLBACK_MAX_FRAMES);
+  log("online: snapshots cover %zu bytes in %zu spans (%zu exclusions), set up in %llu ms", g_savestates.bytes(),
+      g_savestates.spans().size(), exclusions.size(),
+      (unsigned long long)(armTicksToNs(armGetSystemTick() - t0) / 1000000));
+}
+static void rollback_capture(int32_t frame) {
+  if (!g_savestates.active()) rollback_begin();
+  g_savestates.capture(frame);
+  const auto& s = g_savestates.stats();
+  if (s.captures <= 3 || s.captures % 600 == 0) rollback_stats("so far");
+}
+static void rollback_load(int32_t frame, const uint8_t* payload) {
+  if (rb_be32(payload + 4) != 0) log("online: ignoring a savestate preserve list (native state is excluded)");
+  if (!g_savestates.load(frame)) { log("online: no snapshot kept for frame %d", int(frame)); return; }
+  gx::mark_discontinuity(true);   // the next frame continues from an older state: no blending across it
+  slippi::online::note_rollback(frame);
+  if (g_savestates.stats().loads <= 3 || g_savestates.stats().loads % 200 == 0) rollback_stats("so far");
+}
+
+int32_t h_slippi(uint8_t command, const uint8_t* p, uint32_t n, uint8_t* out, uint32_t cap, uint32_t* size) {
+  if (size) *size = 0;
+  std::vector<uint8_t> reply;
+  if (command == 0xF8 && (n == 0 || n == 8) && (hp_te_words() || te_mode)) {
+    if (!te_loaded) load_te_words();
+    if (n == 8) {
+      const uint32_t a = uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+      const uint32_t b = uint32_t(p[4]) << 24 | uint32_t(p[5]) << 16 | uint32_t(p[6]) << 8 | p[7];
+      // TE's "Lock settings": while it is on, only switching the lock off goes through.
+      if (te_mode && (te_w2 & MU_GAME_OPTION2_TE_LOCK_SETTINGS)) {
+        if (!(b & MU_GAME_OPTION2_TE_LOCK_SETTINGS)) te_w2 &= ~MU_GAME_OPTION2_TE_LOCK_SETTINGS;
+      } else { te_w1 = a & te_mask1(); te_w2 = b & te_mask2(); }
+      save_te_words();
+      log("20xx: menu options %08X %08X", unsigned(te_w1), unsigned(te_w2));
+    }
+    if (cap < 8 || !out) return n == 8 ? 0 : -2;
+    const uint32_t w[2] = {te_w1 | (te_mode ? MU_GAME_OPTION_TE : 0u), te_w2};
+    for (int i = 0; i < 2; ++i) for (int k = 0; k < 4; ++k) out[i * 4 + k] = uint8_t(w[i] >> (24 - 8 * k));
+    if (size) *size = 8;
+    return 0;
+  }
+  // The Slippi option: everything else is Slippi's (account, matchmaking, chat, reports), answered by
+  // melee-unlocked's Slippi layer (runtime/hle/slippi_online.cpp) as its Source Port host does.
+  // Rollback savestates are served natively (rollback_* above), as app/source_host.cpp does.
+  if (slippi_mode && command != MU_HP_COMMAND)
+    return slippi::online::native_command(command, p, n, out, cap, size, MU_SLIPPI_RESPONSE_CAPACITY, true,
+        [](uint8_t c, const uint8_t* pp, uint32_t nn, std::vector<uint8_t>& reply) {
+          if (c == slippi::online::CMD_CAPTURE_SAVESTATE && nn >= 4) { rollback_capture(int32_t(rb_be32(pp))); return true; }
+          if (c == slippi::online::CMD_LOAD_SAVESTATE && nn >= 8) { rollback_load(int32_t(rb_be32(pp)), pp); return true; }
+          if (c == slippi::online::CMD_ONLINE_INPUTS && nn >= 4) {
+            // A new match starts at pad frame 1 (resent while waiting for the opponent): set the
+            // snapshot pool up on the first one only.
+            static int32_t last_pad_frame = 0;
+            const int32_t pad_frame = int32_t(rb_be32(pp));
+            if (pad_frame == 1 && last_pad_frame != 1) {
+              if (g_savestates.active()) rollback_stats("previous match");
+              rollback_begin();
+            }
+            last_pad_frame = pad_frame;
+          }
+          return slippi::online::handle(c, pp, nn, reply);
+        });
+  if (command != MU_HP_COMMAND) return -1;
+  if (n >= 1 && p[0] == MU_HP_OP_CPU_WORD) {
+    // The pack's menu asks for the CPU training options; this port keeps none yet (all off).
+    if (source_port::hackpack::loaded()) reply.assign(4, 0);
+  } else {
+    source_port::hackpack::command(p, n, reply, true);
+  }
+  if (reply.size() > cap || (!out && !reply.empty())) return -2;
+  if (!reply.empty()) std::memcpy(out, reply.data(), reply.size());
+  if (size) *size = uint32_t(reply.size());
+  save_pack_settings();
+  return 0;
+}
