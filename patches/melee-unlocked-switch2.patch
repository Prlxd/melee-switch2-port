+BOOL GetFileAttributesExA(LPCSTR path, GET_FILEEX_INFO_LEVELS, LPVOID out) {
+  struct stat st {};
+  if (!path || !out || stat(path, &st) != 0) return FALSE;
+  auto* d = static_cast<WIN32_FILE_ATTRIBUTE_DATA*>(out);
+  std::memset(d, 0, sizeof *d);
+  d->nFileSizeHigh = DWORD(uint64_t(st.st_size) >> 32);
+  d->nFileSizeLow = DWORD(uint64_t(st.st_size));
+  return TRUE;
+}
