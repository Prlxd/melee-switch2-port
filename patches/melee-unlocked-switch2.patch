+// Windows text conversion (UTF-8 <-> wchar_t): enough for the ASCII the Slippi layer passes.
+int MultiByteToWideChar(UINT, DWORD, LPCSTR in, int in_bytes, LPWSTR out, int out_chars) {
+  if (!in) return 0;
+  const int n = in_bytes < 0 ? int(std::strlen(in)) + 1 : in_bytes;
+  if (!out || !out_chars) return n;
+  const int m = n < out_chars ? n : out_chars;
+  for (int i = 0; i < m; ++i) out[i] = wchar_t(static_cast<unsigned char>(in[i]));
+  return m;
+}
+int WideCharToMultiByte(UINT, DWORD, LPCWSTR in, int in_chars, LPSTR out, int out_bytes, LPCSTR, BOOL*) {
+  if (!in) return 0;
+  const int n = in_chars < 0 ? int(std::wcslen(in)) + 1 : in_chars;
+  if (!out || !out_bytes) return n;
+  const int m = n < out_bytes ? n : out_bytes;
+  for (int i = 0; i < m; ++i) out[i] = char(in[i] < 0x80 ? in[i] : '?');
+  return m;
+}
