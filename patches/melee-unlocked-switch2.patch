+    lo = std::min(lo, nx); hi = std::max(hi, nx);
+  }
+  *out_lo = lo; *out_hi = hi;
+  // Up to 1.2: the title screen's curved top and bottom bands reach 1.126 (build 42's record); the
+  // next widest thing there is 0.91, and real backgrounds run well past 1.2.
+  // (1.3 since build 53: the stage select's "Now loading" shade and band, a guess from a photo.)
+  return !ortho && lo <= -0.95f && hi >= 0.95f && lo >= -1.3f && hi <= 1.3f;
+}
