+uint32_t h_zero_u32() { return 0; }
+float h_one_f32() { return 1.0f; }
+#ifdef MU_SWITCH_GRAPHICS
+// sdmc:/switch/melee/config.ini, one "key=value" per line:
+//   widescreen=1   True 16:9 (more of the stage to each side), 0 for the original 4:3 picture
+//   scale=4        internal resolution: 1 = 640x528 (original), 2 = 1280x1056, 4 = 2560x2112 (default)
+#define HD_HELP "# hdtextures: custom textures. 1 = use Dolphin-format texture packs, each in its own folder in sdmc:/switch/melee/textures/, 0 = off\n"
+#define RUMBLE_HELP "# rumble: controller rumble. 0 = off, 50 = normal, 100 = strongest (Melee's own per-player Rumble option also applies)\n"
+// Opens config.ini to add a setting at the end, first ending the last line if the file doesn't end
+// with one (a value typed in by hand with no line break after it would otherwise run into ours).
+FILE* config_append() {
+  bool ends_open = false;
+  if (FILE* r = std::fopen(MU_SD_DIR "/config.ini", "rb")) {
+    if (std::fseek(r, -1, SEEK_END) == 0) { const int c = std::fgetc(r); ends_open = c != '\n' && c != EOF; }
+    std::fclose(r);
+  }
+  FILE* a = std::fopen(MU_SD_DIR "/config.ini", "a");
+  if (a && ends_open) std::fputc('\n', a);
+  return a;
+}
+#define LOGGING_HELP "# logging: 1 = write boot.log, gl.log and launches.txt to the logs folder (for reporting a problem), 0 = no logs\n"
+#define CPU_20XX_HELP "# cpu20xx: CPUs play with the 20XX AI. 1 = only in 20XX Tournament Edition, 2 = always, 0 = never\n"
+void load_settings() {
+  bool seen_tap_jump = false, seen_cpu_20xx = false, seen_logging = false, seen_rumble = false, seen_hd = false;
+  if (FILE* f = std::fopen(MU_SD_DIR "/config.ini", "r")) {
+    char line[256];
+    while (std::fgets(line, sizeof line, f)) {
+      char key[64]; double number = 0;
+      if (std::sscanf(line, " %63[a-z_0-9] = %lf", key, &number) != 2) continue;
+      const int value = int(number);
+      if (!std::strcmp(key, "widescreen")) {}   // always 16:9 with the menu layers stretched (the old setting is ignored)
+      else if (!std::strcmp(key, "scale")) settings.scale = std::clamp(std::round(number * 4) / 4, 1.0, 4.0);   // steps of 0.25
+      else if (!std::strcmp(key, "logging")) seen_logging = true;
+      else if (!std::strcmp(key, "hdtextures")) seen_hd = true;
+      else if (!std::strcmp(key, "rumble")) { settings.rumble = std::clamp(value, 0, 100); seen_rumble = true; }
+      else if (!std::strcmp(key, "tapjump")) { settings.tap_jump = value != 0; seen_tap_jump = true; }
+      else if (!std::strcmp(key, "cpu20xx")) { settings.cpu_20xx = std::clamp(value, 0, 2); seen_cpu_20xx = true; }
+    }
+    std::fclose(f);
+    // Settings added after the file was made are appended with their defaults, so they can be found.
+    if (!seen_rumble) if (FILE* a = config_append()) {
+      std::fputs(RUMBLE_HELP "rumble=0\n", a);
+      std::fclose(a);
+    }
+    if (!seen_hd) if (FILE* a = config_append()) {
+      std::fputs(HD_HELP "hdtextures=0\n", a);
+      std::fclose(a);
+    }
+    if (!seen_logging) if (FILE* a = config_append()) {
+      std::fputs(LOGGING_HELP "logging=0\n", a);
+      std::fclose(a);
+    }
+    if (!seen_tap_jump) if (FILE* a = config_append()) {
+      std::fputs("# tapjump: 1 = pushing the stick up jumps (normal), 0 = only X/Y jump\ntapjump=1\n", a);
+      std::fclose(a);
+    }
+    if (!seen_cpu_20xx) if (FILE* a = config_append()) {
+      std::fputs(CPU_20XX_HELP "cpu20xx=1\n", a);
+      std::fclose(a);
+    }
+  } else if (FILE* f = std::fopen(MU_SD_DIR "/config.ini", "w")) {
+    std::fputs("# Melee (Switch 2 Port) settings. Delete this file to get the defaults back.\n"
+
+               "# scale: internal resolution, 1 = original 640x528, 1.5 = 960x792, 2 = 1280x1056, 3 = 1920x1584, 4 = 2560x2112\n"
+               "scale=4\n"
+               "# tapjump: 1 = pushing the stick up jumps (normal), 0 = only X/Y jump\n"
+               "tapjump=1\n"
+               CPU_20XX_HELP "cpu20xx=1\n"
+               "# boot: which game starts. ask = pick each time, normal, te (20XX Tournament Edition), slippi\n"
+               "# (with a default set, press L just after launching to get the picker back)\n"
+               "boot=ask\n"
+               RUMBLE_HELP "rumble=0\n"
+               HD_HELP "hdtextures=0\n"
+               LOGGING_HELP "logging=0\n"
+               "# crashtrail: 1 = also record what ran just before a crash (slows the game; turns logging on)\n"
+               "crashtrail=0\n", f);
+    std::fclose(f);
+  }
+}
