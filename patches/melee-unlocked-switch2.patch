+
+// ---- crash report ----
+// libnx calls __libnx_exception_handler on its own stack when any thread faults. It writes
+// sdmc:/melee/crash.log: the fault, the registers, the frame-pointer chain and every value on the
+// faulting stack that points into the NRO's code, each also as an offset from the NRO's load address
+// (what addr2line needs against meleeboot.elf).
+extern "C" {
+alignas(16) u8 __nx_exception_stack[0x10000];
+u64 __nx_exception_stack_size = sizeof(__nx_exception_stack);
+}
+namespace {
+bool readable(u64 address, u64 size) {
+  MemoryInfo info{}; u32 page = 0;
+  if (R_FAILED(svcQueryMemory(&info, &page, address))) return false;
+  return (info.perm & Perm_R) && address + size <= info.addr + info.size;
+}
+}
+extern "C" void __libnx_exception_handler(ThreadExceptionDump* ctx) {
+  static bool once = false;
+  if (once) svcExitProcess();
+  once = true;
+  FILE* f = std::fopen("sdmc:/melee/crash.log", "w");
+  if (f) {
+    const u64 base = switch_host::image_base();
+    MemoryInfo code{}; u32 page = 0;
+    svcQueryMemory(&code, &page, base);
+    const u64 code_end = base + code.size;
+    auto off = [&](u64 a) { return a >= base && a < code_end ? a - base : ~0ull; };
+    std::fprintf(f, "Melee boot test crash\n");
+    std::fprintf(f, "desc=0x%x esr=0x%x far=0x%llx\n", ctx->error_desc, ctx->esr, (unsigned long long)ctx->far.x);
+    std::fprintf(f, "nro base=0x%llx code_end=0x%llx\n", (unsigned long long)base, (unsigned long long)code_end);
+    std::fprintf(f, "pc=0x%llx (+0x%llx)\nlr=0x%llx (+0x%llx)\nsp=0x%llx fp=0x%llx\n",
+                 (unsigned long long)ctx->pc.x, (unsigned long long)off(ctx->pc.x),
+                 (unsigned long long)ctx->lr.x, (unsigned long long)off(ctx->lr.x),
+                 (unsigned long long)ctx->sp.x, (unsigned long long)ctx->fp.x);
+    for (int i = 0; i < 29; ++i)
+      std::fprintf(f, "x%-2d=0x%016llx%s", i, (unsigned long long)ctx->cpu_gprs[i].x, i % 3 == 2 ? "\n" : "  ");
+    std::fprintf(f, "\nframes (fp chain):\n");
+    u64 fp = ctx->fp.x;
+    for (int i = 0; i < 48 && fp && !(fp & 15) && readable(fp, 16); ++i) {
+      const u64 next = reinterpret_cast<const u64*>(fp)[0], ret = reinterpret_cast<const u64*>(fp)[1];
+      std::fprintf(f, "  #%-2d +0x%llx\n", i, (unsigned long long)off(ret));
+      if (next <= fp) break;
+      fp = next;
+    }
+    std::fprintf(f, "stack values in code:\n");
+    const u64 sp = ctx->sp.x;
+    int found = 0;
+    for (u64 a = sp; a < sp + 0x4000 && found < 64; a += 8) {
+      if (!readable(a, 8)) break;
+      const u64 v = *reinterpret_cast<const u64*>(a);
+      if (off(v) != ~0ull) { std::fprintf(f, "  sp+0x%llx: +0x%llx\n", (unsigned long long)(a - sp), (unsigned long long)off(v)); ++found; }
+    }
+    std::fclose(f);
+  }
+  switch_host::log("CRASH: desc=0x%x pc=0x%llx far=0x%llx (details in crash.log)", ctx->error_desc,
+                   (unsigned long long)ctx->pc.x, (unsigned long long)ctx->far.x);
+  svcExitProcess();
+}
