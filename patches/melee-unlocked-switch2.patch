diff --git a/sourceport/game/akaneia/mu_ak_fighters.c b/sourceport/game/akaneia/mu_ak_fighters.c
index 05c346f..12a16ea 100644
--- a/sourceport/game/akaneia/mu_ak_fighters.c
+++ b/sourceport/game/akaneia/mu_ak_fighters.c
@@ -419,12 +419,21 @@ const void* mu_ak_cpu_list(mu_u32 raw)
     static const unsigned long long zeros[0x80];
     const mu_u32 offset = raw & 0x3FFFFFFFu;
 
+#if defined(MU_SWITCH2)
+    /* On the Switch the game's addresses are the NRO image and MEM1 (0x08000000 up to the end of
+     * MEM1), with no high bit to tell them apart: an address is anything in that range. Testing bit
+     * 31 here sent every real list to the empty one below, so CPUs never chose an attack. */
+    if (raw == 0 || (raw >= MU_GUEST_FLOOR && raw < (mu_u32) (MU_MEM1_BASE + 0x02800000u))) {
+        return (const void*) (mu_uptr) raw;
+    }
+#else
     if (raw == 0 || (raw & 0x80000000u) != 0) {
         return (const void*) (mu_uptr) raw;
     }
+#endif
     /* Not a game address: the console reads RAM at the offset while it is inside its 24 MB, and
      * 0 past it. */
-    return offset < 0x01800000u ? (const void*) (mu_uptr) (0x80000000u + offset) : (const void*) zeros;
+    return offset < 0x01800000u ? (const void*) (mu_uptr) (MU_MEM1_BASE + offset) : (const void*) zeros;
 }
 
