+// config.ini "iso=<file name>" picks the disc when sdmc:/melee holds more than one.
+std::string configured_iso() {
+  FILE* f = std::fopen("sdmc:/melee/config.ini", "r");
+  if (!f) return {};
+  char line[512]; std::string name;
+  while (std::fgets(line, sizeof line, f)) {
+    if (std::strncmp(line, "iso=", 4)) continue;
+    name = line + 4;
+    while (!name.empty() && (name.back() == '\n' || name.back() == '\r' || name.back() == ' ')) name.pop_back();
+  }
+  std::fclose(f);
+  return name.empty() ? std::string{} : "sdmc:/melee/" + name;
+}
+std::string find_iso() {
+  std::error_code ec;
+  if (auto chosen = configured_iso(); !chosen.empty() && std::filesystem::is_regular_file(chosen, ec)) return chosen;
+  for (std::filesystem::directory_iterator it("sdmc:/melee", ec), end; !ec && it != end; it.increment(ec)) {
+    std::string ext = it->path().extension().string();
+    std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+    std::string stem = it->path().filename().string();
+    std::transform(stem.begin(), stem.end(), stem.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+    if (ext == ".iso" && stem != "20xx.iso") return it->path().string();
+  }
+  return {};
+}
+
+// config.ini "boot=": ask (the default) shows a picker when both the normal ISO and the 20XX ISO are
+// there; "normal" or "20xx" boots that one straight away. The last pick is remembered in
+// sdmc:/melee/last-boot.txt and starts highlighted.
+std::string config_value(const char* key) {
+  FILE* f = std::fopen("sdmc:/melee/config.ini", "r");
+  if (!f) return {};
+  char line[512]; std::string value; const size_t n = std::strlen(key);
+  while (std::fgets(line, sizeof line, f)) {
+    if (std::strncmp(line, key, n) || line[n] != '=') continue;
+    value = line + n + 1;
+    while (!value.empty() && (value.back() == '\n' || value.back() == '\r' || value.back() == ' ')) value.pop_back();
+  }
+  std::fclose(f);
+  for (char& c : value) c = char(std::tolower((unsigned char)c));
+  return value;
+}
+void ensure_boot_setting() {
+  if (!config_value("boot").empty()) return;
+  FILE* f = std::fopen("sdmc:/melee/config.ini", "r");
+  if (!f) return;   // load_settings() writes the file later, with this line
+  std::fclose(f);
+  if (FILE* a = switch_host::config_append()) {
+    std::fputs("# boot: which game starts. ask = pick each time, normal, te (20XX Tournament Edition)\nboot=ask\n", a);
+    std::fclose(a);
+  }
+}
+// Replaces (or adds) "key=value" in config.ini, keeping every other line as it is.
+void set_config_value(const char* key, const char* value) {
+  std::string out; bool done = false; const size_t n = std::strlen(key);
+  if (FILE* f = std::fopen("sdmc:/melee/config.ini", "r")) {
+    char line[512];
+    while (std::fgets(line, sizeof line, f)) {
+      if (!std::strncmp(line, key, n) && line[n] == '=') { out += std::string(key) + "=" + value + "\n"; done = true; }
+      else out += line;
+    }
+    std::fclose(f);
+  }
+  if (!done) out += std::string(key) + "=" + value + "\n";
+  if (FILE* f = std::fopen("sdmc:/melee/config.ini", "w")) { std::fputs(out.c_str(), f); std::fclose(f); }
+}
+// The launcher's screens are pictures drawn ahead of time (launcher/make.py, launcher_art.h),
+// unpacked with zlib and copied to the screen: no text console.
+struct Screen {
+  Framebuffer fb{}; bool open = false; std::vector<uint8_t> pixels;
+  Screen() { open = R_SUCCEEDED(framebufferCreate(&fb, nwindowGetDefault(), 1280, 720, PIXEL_FORMAT_RGBA_8888, 2)); if (open) framebufferMakeLinear(&fb); }
+  ~Screen() { if (open) framebufferClose(&fb); }
+  // The picker: the two pictures side by side (unpacked once), with one overlay blended on top.
+  std::vector<uint8_t> halves[2], over;
+  void show(const LauncherArt& overlay) {
+    if (!open) return;
+    for (int i = 0; i < 2; ++i) if (halves[i].empty()) {
+      halves[i].resize(640u * 720u * 3u);
+      uLongf size = uLongf(halves[i].size());
+      if (uncompress(halves[i].data(), &size, art_half[i].data, uLong(art_half[i].size)) != Z_OK) std::fill(halves[i].begin(), halves[i].end(), 51);
+    }
+    over.resize(1280u * 720u * 4u);
+    uLongf size = uLongf(over.size());
+    if (uncompress(over.data(), &size, overlay.data, uLong(overlay.size)) != Z_OK) std::fill(over.begin(), over.end(), 0);
+    pixels.resize(1280u * 720u * 4u);
+    for (int y = 0; y < 720; ++y) for (int x = 0; x < 1280; ++x) {
+      const uint8_t* b = halves[x / 640].data() + (size_t(y) * 640 + x % 640) * 3;
+      const uint8_t* o = over.data() + (size_t(y) * 1280 + x) * 4;
+      uint8_t* out = pixels.data() + (size_t(y) * 1280 + x) * 4;
+      const unsigned a = o[3];
+      for (int c = 0; c < 3; ++c) out[c] = uint8_t((b[c] * (255 - a) + o[c] * a + 127) / 255);
+      out[3] = 255;
+    }
+    present();
+  }
+  // The options screen: its background, with the pieces for the current state laid over it.
+  std::vector<uint8_t> opt_bg_px;
+  void blit(const OptSprite& s, int x0, int y0) {
+    std::vector<uint8_t> px(size_t(s.w) * s.h * 4);
+    uLongf size = uLongf(px.size());
+    if (uncompress(px.data(), &size, s.data, uLong(s.size)) != Z_OK) return;
+    for (int y = 0; y < s.h; ++y) for (int x = 0; x < s.w; ++x) {
+      const int X = x0 + x, Y = y0 + y;
+      if (X < 0 || Y < 0 || X >= 1280 || Y >= 720) continue;
+      const uint8_t* o = px.data() + (size_t(y) * s.w + x) * 4;
+      uint8_t* out = pixels.data() + (size_t(Y) * 1280 + X) * 4;
+      const unsigned a = o[3];
+      for (int c = 0; c < 3; ++c) out[c] = uint8_t((out[c] * (255 - a) + o[c] * a + 127) / 255);
+    }
+  }
+  void show_options(const int value[], int selected) {
+    if (!open) return;
+    if (opt_bg_px.empty()) {
+      opt_bg_px.resize(1280u * 720u * 3u);
+      uLongf size = uLongf(opt_bg_px.size());
+      if (uncompress(opt_bg_px.data(), &size, opt_bg, uLong(sizeof opt_bg)) != Z_OK) std::fill(opt_bg_px.begin(), opt_bg_px.end(), 51);
+    }
+    pixels.resize(1280u * 720u * 4u);
+    for (size_t i = 0; i < 1280u * 720u; ++i) {
+      pixels[i * 4] = opt_bg_px[i * 3]; pixels[i * 4 + 1] = opt_bg_px[i * 3 + 1]; pixels[i * 4 + 2] = opt_bg_px[i * 3 + 2]; pixels[i * 4 + 3] = 255;
+    }
+    blit(opt_band, opt_label_rx - 320, opt_y0 + selected * opt_dy - opt_band.h / 2);
+    for (int row = 0; row < opt_rows; ++row) {
+      const int y = opt_y0 + row * opt_dy;
+      if (row == selected) blit(opt_label[row], opt_label_rx - opt_label[row].w, y - opt_label[row].h / 2);
+      const OptSprite& v = row == selected ? opt_value_sel[value[row]] : opt_value[value[row]];
+      blit(v, opt_value_cx - v.w / 2, y - v.h / 2);
+    }
+    blit(opt_desc[selected], 640 - opt_desc[selected].w / 2, opt_desc_y - opt_desc[selected].h / 2);
+    present();
+  }
+  void black() { pixels.assign(1280u * 720u * 4u, 0); for (size_t i = 3; i < pixels.size(); i += 4) pixels[i] = 255; present(); }
+  void present() {
+    if (!open || pixels.empty()) return;
+    u32 stride = 0;
+    uint8_t* out = static_cast<uint8_t*>(framebufferBegin(&fb, &stride));
+    for (int y = 0; y < 720; ++y) std::memcpy(out + size_t(y) * stride, pixels.data() + size_t(y) * 1280 * 4, 1280 * 4);
+    framebufferEnd(&fb);
+  }
+};
+// L pressed while the start screen shows: open the picker even when a default game is set. (Under
+// kaiHEN a button already held when the program starts is not reported; it has to go down after.)
+bool l_pressed_on_start(PadState& pad, Screen& screen) {
+  // A plain black screen for about a second, as the loading that follows is: nothing to read.
+  // Also timed: how fast the screen takes frames from a program (60 or 120 a second).
+  u64 seen = 0; int frames = 0;
+  const u64 start = armGetSystemTick();
+  bool pressed = false;
+  for (; appletMainLoop() && armTicksToNs(armGetSystemTick() - start) < 1'500'000'000ull; ++frames) {   // 1.5 s by the clock
+    screen.present();   // waits for the screen's refresh
+    padUpdate(&pad);
+    seen |= padGetButtons(&pad);
+    if (seen & (HidNpadButton_L | HidNpadButton_ZL)) { pressed = true; break; }
+  }
+  const double secs = armTicksToNs(armGetSystemTick() - start) / 1e9;
+  char note[128];
+  std::snprintf(note, sizeof note, "picker: L %s (buttons seen %llx, %.2f s, %d frames)",
+                pressed ? "pressed, showing the game picker" : "not pressed", (unsigned long long)seen, secs, frames);
+  launch_note(note);
+  return pressed;
+}
+// The options screen (X on the picker): rumble, tap jump, scale and logging, saved to config.ini
+// as they change. The game reads them when it starts, which is after the picker.
+// Rows: 0 rumble, 1 tap jump, 2 scale, 3 logging. Values index opt_value: 0 On, 1 Off, 2.. scales.
+void options_menu(PadState& pad, Screen& screen) {
+  static const char* const kScales[] = {"1", "1.5", "2", "3", "4"};
+  auto number = [](const char* key, double fallback) {
+    const std::string v = config_value(key);
+    char* end = nullptr; const double d = v.empty() ? fallback : std::strtod(v.c_str(), &end);
+    return end && end != v.c_str() ? d : fallback;
+  };
+  int value[4];
+  value[0] = number("rumble", 0) > 0 ? 0 : 1;
+  value[1] = number("tapjump", 1) != 0 ? 0 : 1;
+  const double scale = number("scale", 2);
+  int s = 0;
+  for (int i = 0; i < 5; ++i) if (std::fabs(std::atof(kScales[i]) - scale) < std::fabs(std::atof(kScales[s]) - scale)) s = i;
+  value[2] = 2 + s;
+  value[3] = number("logging", 0) != 0 ? 0 : 1;
+  int selected = 0; bool redraw = true;
+  while (appletMainLoop()) {
+    padUpdate(&pad);
+    const u64 down = padGetButtonsDown(&pad);
+    if (down & (HidNpadButton_B | HidNpadButton_X | HidNpadButton_Plus)) break;
+    if (down & HidNpadButton_AnyUp) { selected = (selected + 3) % 4; redraw = true; }
+    if (down & HidNpadButton_AnyDown) { selected = (selected + 1) % 4; redraw = true; }
+    const int step = (down & HidNpadButton_AnyRight) ? 1 : (down & HidNpadButton_AnyLeft) ? -1 : (down & HidNpadButton_A) ? 1 : 0;
+    if (step) {
+      if (selected == 2) {
+        const int i = std::clamp(value[2] - 2 + step, 0, 4);
+        value[2] = 2 + i; set_config_value("scale", kScales[i]);
+      } else {
+        value[selected] = value[selected] == 0 ? 1 : 0;
+        const bool on = value[selected] == 0;
+        if (selected == 0) set_config_value("rumble", on ? "50" : "0");
+        if (selected == 1) set_config_value("tapjump", on ? "1" : "0");
+        if (selected == 3) set_config_value("logging", on ? "1" : "0");
+      }
+      redraw = true;
+    }
+    if (redraw) { screen.show_options(value, selected); redraw = false; }
+    else screen.present();
+  }
+}
+// Which game to start: 0 the normal game, 1 20XX Tournament Edition. config.ini boot= holds the
+// default: ask, normal, te.
+int pick_game() {
+  padConfigureInput(8, HidNpadStyleSet_NpadStandard);
+  PadState pad; padInitializeAny(&pad);
+  std::string mode = config_value("boot");
+  if (mode == "20xx" || mode == "20xxte") mode = "te";
+  const int fixed = mode == "normal" ? 0 : mode == "te" ? 1 : -1;
+  Screen screen;
+  if (fixed >= 0) {
+    screen.black();
+    if (!l_pressed_on_start(pad, screen)) return fixed;
+  }
+  int choice = fixed == 1 ? 1 : 0;
+  if (fixed < 0)
+    if (FILE* f = std::fopen("sdmc:/melee/last-boot.txt", "r")) { char c = 0; if (std::fread(&c, 1, 1, f) == 1 && c == '1') choice = 1; std::fclose(f); }
+  bool chosen = false, redraw = true, make_default = false;
+  while (appletMainLoop() && !chosen) {
+    padUpdate(&pad);
+    const u64 down = padGetButtonsDown(&pad);
+    if (down & (HidNpadButton_AnyLeft | HidNpadButton_AnyUp)) { choice = 0; redraw = true; }
+    if (down & (HidNpadButton_AnyRight | HidNpadButton_AnyDown)) { choice = 1; redraw = true; }
+    if (down & HidNpadButton_A) { chosen = true; make_default = true; }
+    if (down & HidNpadButton_Y) chosen = true;   // this time only
+    if (down & HidNpadButton_X) { options_menu(pad, screen); redraw = true; }
+    if (redraw) { screen.show(art_overlay[choice][fixed + 1]); redraw = false; }
+    else screen.present();
+  }
+  if (FILE* f = std::fopen("sdmc:/melee/last-boot.txt", "w")) { std::fputc(choice ? '1' : '0', f); std::fclose(f); }
+  if (make_default) set_config_value("boot", choice ? "te" : "normal");
+  return choice;
+}
+}
+
+int main(int, char**) {
+  std::error_code ec;
+  // Keep the logs of the two runs before this one (boot.1.log, boot.2.log, and gl.*): a launch that
+  // dies early would otherwise lose its log to the next launch.
+  switch_host::g_sweep_requested = config_value("shadersweep") == "1";
+  // gpuprofile=1: per-draw GPU timings in gl.log (renderer_gl.cpp, profile_*); turns logging on
+  const bool gpu_profile = config_value("gpuprofile") == "1";
+  if (gpu_profile) setenv("MU_GPU_PROFILE", "1", 1);
+  g_logging = config_value("logging") == "1" || config_value("crashtrail") == "1" || switch_host::g_sweep_requested || gpu_profile;
+  if (g_logging) for (const char* name : {"boot", "gl"}) {
+    const std::string base = std::string("sdmc:/melee/") + name;
+    std::filesystem::remove(base + ".2.log", ec);
+    std::filesystem::rename(base + ".1.log", base + ".2.log", ec);
+    std::filesystem::rename(base + ".log", base + ".1.log", ec);
+  }
+  launch_note("started");
+  std::filesystem::create_directories("sdmc:/melee/card-a", ec);
+  switch_host::Config cfg;
+  cfg.log_path = "sdmc:/melee/boot.log";
+  cfg.card_dir = "sdmc:/melee/card-a";
+  cfg.iso_path = find_iso();
+  // Two games, both on the normal disc: Melee as it is, or 20XX Tournament Edition (boot= in config.ini).
+  ensure_boot_setting();
+  if (!cfg.iso_path.empty()) {
+    cfg.tournament_edition = switch_host::g_sweep_requested ? false : pick_game() == 1;
+    const bool was_logging = g_logging;
+    g_logging = config_value("logging") == "1" || config_value("crashtrail") == "1" || switch_host::g_sweep_requested || gpu_profile;
+    if (g_logging && !was_logging) for (const char* name : {"boot", "gl"}) {   // switched on in the options just now
+      const std::string base = std::string("sdmc:/melee/") + name;
+      std::filesystem::remove(base + ".2.log", ec);
+      std::filesystem::rename(base + ".1.log", base + ".2.log", ec);
+      std::filesystem::rename(base + ".log", base + ".1.log", ec);
+    }   // the sweep plays Melee itself
+    launch_note(cfg.tournament_edition ? "game: 20XX Tournament Edition" : "game: Melee");
+  }
+#ifndef MU_SWITCH_GRAPHICS
+  cfg.max_frames = 60 * 120;   // The boot test (no picture) stops itself after two minutes of game time.
+#endif
+  std::string error;
+  int code = 1;
+  if (cfg.iso_path.empty()) error = "no .iso file in sdmc:/melee";
+  else if (switch_host::initialize(cfg, &error)) code = switch_host::run();
+  if (!error.empty()) {
+    switch_host::log("FAILED: %s", error.c_str());
+    // Before initialize opened the log (no ISO found), write it directly.
+    if (FILE* f = std::fopen("sdmc:/melee/boot.log", "a")) { std::fprintf(f, "FAILED: %s\n", error.c_str()); std::fclose(f); }
+  }
+  switch_host::shutdown();
+  launch_note(code == 0 ? "ended" : "ended with an error");
+  switch_host::mu_quit_note_end();
+  return code;
+}
+
+extern "C" {
+int mu_crumbs_on = 0;
+void mu_switch_crumb(unsigned kind, unsigned long value) { switch_host::crumb(kind, value); }
+}
diff --git a/port/switch2/prelink_game.sh b/port/switch2/prelink_game.sh
new file mode 100755
index 0000000..d9b7270
--- /dev/null
+++ b/port/switch2/prelink_game.sh
@@ -0,0 +1,20 @@
+#!/bin/sh
+# Pre-links the game library into one object for the Switch 2 NRO.
+#  1. ld -r: one object, so the game's own C library names can be made private.
+#  2. Every data section (one per variable, -fdata-sections) is raised to 32-byte alignment. The
+#     console's DMA (disc, ARAM) needs 32-byte-aligned buffers, and many of the game's static buffers
+#     only got that from x86-64 GCC's habit of aligning arrays of 32 bytes or more to 32; AArch64 GCC
+#     aligns them to 8 or 16. String-merge sections are left alone.
+#  3. objcopy keeps only mu_game_entry global.
+# usage: prelink_game.sh <devkitA64 bin dir> <libmelee_game.a> <out.o>
+set -eu
+B=$1; LIB=$2; OUT=$3
+TMP=$(mktemp -d)
+"$B/aarch64-none-elf-ld" -r --whole-archive "$LIB" -o "$TMP/r.o"
+"$B/aarch64-none-elf-objdump" -h "$TMP/r.o" | awk '$2 ~ /^\.(data|bss|rodata|sdata|sbss)(\.|$)/ && $2 !~ /\.str[0-9.]*$/ && $2 !~ /\.cst[0-9]+/ {print $2}' > "$TMP/sections"
+# objcopy reads options from a response file, so thousands of sections fit.
+awk '{print "--set-section-alignment " $1 "=32"}' "$TMP/sections" > "$TMP/align.rsp"
+echo "--keep-global-symbol=mu_game_entry" >> "$TMP/align.rsp"
+"$B/aarch64-none-elf-objcopy" @"$TMP/align.rsp" "$TMP/r.o" "$OUT"
+echo "prelink: $(wc -l < "$TMP/sections") data sections aligned to 32"
+rm -rf "$TMP"
diff --git a/port/switch2/presenter_switch.cpp b/port/switch2/presenter_switch.cpp
new file mode 100644
index 0000000..6b5cc30
--- /dev/null
+++ b/port/switch2/presenter_switch.cpp
@@ -0,0 +1,161 @@
+// Threaded presentation on Switch 2: the game thread decodes GX into frames and hands each to a render
+// thread that owns the OpenGL context and the renderer (port/linux/renderer_gl.cpp). The same design as
+// port/linux/renderer_presenter.cpp at a fixed 60 Hz, but on a libnx thread with a 16 MB stack: the
+// renderer translates shaders on its own thread (glslang is deeply recursive) and a std::thread's stack
+// cannot be set here.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <switch.h>
+#include "renderer_gl.h"
+#include "frame_queue.h"
+#include "render_options.h"
+#include "gx_shader.h"
+#include <atomic>
+#include <chrono>
+#include <exception>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+extern "C" void mu_quit_note(const char* step);
+
+// What the render thread is doing, for the watchdog when the game stalls waiting for it.
+static std::atomic<const char*> g_render_stage{"starting"};
+extern "C" const char* mu_render_stage(const char* now) { return g_render_stage.exchange(now); }
+extern "C" const char* mu_render_stage_now() { return g_render_stage.load(); }
+static std::atomic<const char*> g_game_wait{"not waiting"};
+extern "C" const char* mu_game_wait_now() { return g_game_wait.load(); }
+
+namespace switch_host { void log(const char* format, ...); }
+
+namespace linux_renderer {
+namespace {
+class SwitchPresenter final : public gx::Backend {
+ public:
+  SwitchPresenter(SDL_Window* window, std::filesystem::path cache, int core, double scale, bool widescreen)
+      : window_(window), cache_(std::move(cache)), scale_(scale) {
+    // True widescreen: the renderer shows more of the world to each side (16:9) and the game draws
+    // fighters there; the screen is filled instead of pillarboxed to Melee's 73:60.
+    options_.true_widescreen = widescreen;
+    options_.efb_scale = int(scale);
+    gx::set_true_widescreen(widescreen, 16.0f / 9.0f);
+    s32 priority = 0x2C;
+    svcGetThreadPriority(&priority, CUR_THREAD_HANDLE);
+    Result rc = threadCreate(&thread_, entry, this, nullptr, 16u << 20, priority, core);
+    if (R_FAILED(rc) && core != -2) rc = threadCreate(&thread_, entry, this, nullptr, 16u << 20, priority, -2);
+    if (R_FAILED(rc)) throw std::runtime_error("cannot create the render thread");
+    threadStart(&thread_);
+    // Wait for the renderer to come up (or fail) on its thread.
+    while (state_.load() == 0) svcSleepThread(1000000);
+    if (state_.load() < 0) { threadWaitForExit(&thread_); threadClose(&thread_); throw std::runtime_error(error_); }
+  }
+  ~SwitchPresenter() override {
+    mu_quit_note("presenter: telling the render thread to finish");
+    queue_.finish();
+    threadWaitForExit(&thread_);
+    threadClose(&thread_);
+    mu_quit_note("presenter: render thread joined");
+  }
+  void submit_frame(const gx::Frame& frame) override {
+    throttle();
+    if (!queue_.push(frame)) stopped();
+    g_game_wait = "not waiting";
+  }
+  void submit_and_recycle(gx::Frame& frame) override {
+    throttle();
+    if (!queue_.push_and_recycle(frame)) stopped();
+    g_game_wait = "not waiting";
+  }
+  void presentation_stats(uint32_t* frames, uint32_t* pipes, uint32_t* textures) const override {
+    if (frames) *frames = presented_.load();
+    if (pipes) *pipes = pipelines_.load();
+    if (textures) *textures = textures_.load();
+  }
+  bool failed() const { return state_.load() < 0; }
+
+ private:
+  static void entry(void* self) { static_cast<SwitchPresenter*>(self)->run(); }
+  // The game runs ahead of the renderer by at most two frames: more would only add input lag.
+  // Never more than 100 ms: should the two threads ever disagree about the queue, the game goes on
+  // (the queue itself takes up to 32 frames) instead of both waiting on each other for ever.
+  void throttle() {
+    if (state_.load() < 0) stopped();
+    g_game_wait = "waiting for the render queue to drain";
+    for (int i = 0; i < 200 && queue_.size() >= 2 && state_.load() > 0; ++i) svcSleepThread(500000);
+    g_game_wait = "pushing a frame";
+  }
+  [[noreturn]] void stopped() { throw std::runtime_error("renderer stopped: " + error_); }
+  void run() {
+    std::unique_ptr<gx::Backend> renderer;
+    try {
+      renderer = create(window_, cache_, scale_, true);
+      Hooks hooks; hooks.options = &options_;
+      set_hooks(*renderer, std::move(hooks));
+      state_ = 1;
+    } catch (const std::exception& e) {
+      error_ = e.what(); state_ = -1; return;
+    }
+    try {
+      gx::Frame frame;
+      while (true) {
+        mu_render_stage("waiting for the game's next frame");
+        if (!queue_.wait_available(std::chrono::milliseconds(5))) {
+          if (queue_.drained()) break;
+          continue;
+        }
+        if (!queue_.try_pop(frame)) continue;
+        // Behind (drawing slower than the game): skip straight to the newest frame instead of drawing
+        // the old ones unseen, so a heavy stage shows as many frames as drawing allows and the game
+        // itself keeps its full speed. Each Melee frame redraws its own EFB copies before using them.
+        gx::Frame newer;
+        while (queue_.try_pop(newer)) { queue_.recycle(std::move(frame)); frame = std::move(newer); newer = gx::Frame{}; ++dropped_; }
+        const u64 start = armGetSystemTick();
+        mu_render_stage("drawing a frame");
+        renderer->submit_frame(frame); ++presented_;
+        draw_ticks_ += armGetSystemTick() - start;
+        uint32_t pf = 0, pp = 0, pt = 0;
+        renderer->presentation_stats(&pf, &pp, &pt);
+        pipelines_ = pp; textures_ = pt;
+        queue_.recycle(std::move(frame));
+        frame = gx::Frame{};
+      }
+    } catch (const std::exception& e) {
+      error_ = e.what();
+      switch_host::log("renderer: stopped on the render thread: %s", e.what());
+      state_ = -1;
+      queue_.finish(true);
+    }
+    mu_quit_note("render thread: loop ended, closing the renderer");
+    renderer.reset();   // on this thread, which owns the GL context: saves the shader list
+    switch_host::log("renderer: render thread closed, shader list saved");
+  }
+
+  SDL_Window* window_;
+  std::filesystem::path cache_;
+  Thread thread_{};
+  gx::FrameQueue queue_;
+  double scale_ = 1;
+  gx::RenderOptions options_{};
+  std::atomic<u64> draw_ticks_{0};
+  std::atomic<uint32_t> dropped_{0};
+ public:
+  // For boot.log: time spent drawing (including waiting for the screen) and frames skipped.
+  void draw_stats(u64* ticks, uint32_t* dropped) const { *ticks = draw_ticks_.load(); *dropped = dropped_.load(); }
+ private:
+  std::atomic<int> state_{0};        // 0 starting, 1 running, -1 failed
+  std::string error_;
+  std::atomic<uint32_t> presented_{0}, pipelines_{0}, textures_{0};
+};
+} // namespace
+
+void switch_draw_stats(gx::Backend* backend, unsigned long long* ticks, unsigned* dropped) {
+  u64 t = 0; uint32_t d = 0;
+  if (auto* p = dynamic_cast<SwitchPresenter*>(backend)) p->draw_stats(&t, &d);
+  *ticks = t; *dropped = d;
+}
+std::unique_ptr<gx::Backend> create_switch_threaded(SDL_Window* window, const std::filesystem::path& cache, int core,
+                                                    double scale, bool widescreen) {
+  return std::make_unique<SwitchPresenter>(window, cache, core, scale, widescreen);
+}
+} // namespace linux_renderer
diff --git a/port/switch2/sdl_egl.cpp b/port/switch2/sdl_egl.cpp
new file mode 100644
index 0000000..7ac9701
--- /dev/null
+++ b/port/switch2/sdl_egl.cpp
@@ -0,0 +1,133 @@
+// The SDL2 calls renderer_gl.cpp makes, on Switch 2: an OpenGL 4.5 core context through EGL on the
+// default NWindow (Mesa Zink on NVK, from OunceVK), plus the GLEW stand-in's version and extension checks.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <switch.h>
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include "compat/SDL.h"
+#include "compat/GL/glew.h"
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <atomic>
+
+namespace switch_host { void log(const char* format, ...); }
+
+namespace {
+EGLDisplay g_display = EGL_NO_DISPLAY;
+EGLSurface g_surface = EGL_NO_SURFACE;
+EGLContext g_context = EGL_NO_CONTEXT;
+std::string g_error;
+
+bool fail(const char* what) {
+  char line[160];
+  std::snprintf(line, sizeof line, "%s failed (EGL error 0x%x)", what, eglGetError());
+  g_error = line;
+  switch_host::log("gl: %s", line);
+  return false;
+}
+} // namespace
+
+unsigned char glewExperimental = 0;
+unsigned int glewInit() { return GLEW_OK; }
+
+int mu_gl_version() {
+  GLint major = 0, minor = 0;
+  glGetIntegerv(GL_MAJOR_VERSION, &major);
+  glGetIntegerv(GL_MINOR_VERSION, &minor);
+  return major * 10 + minor;
+}
+
+bool mu_gl_extension(const char* name) {
+  GLint count = 0;
+  glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+  for (GLint i = 0; i < count; ++i) {
+    const char* e = reinterpret_cast<const char*>(glGetStringi(GL_EXTENSIONS, GLuint(i)));
+    if (e && !std::strcmp(e, name)) return true;
+  }
+  return false;
+}
+
+SDL_GLContext SDL_GL_CreateContext(SDL_Window*) {
+  if (g_context != EGL_NO_CONTEXT) return g_context;
+  g_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+  if (g_display == EGL_NO_DISPLAY) { fail("eglGetDisplay"); return nullptr; }
+  if (!eglInitialize(g_display, nullptr, nullptr)) { fail("eglInitialize"); return nullptr; }
+  if (!eglBindAPI(EGL_OPENGL_API)) { fail("eglBindAPI(OpenGL)"); return nullptr; }
+  const EGLint config_attributes[] = {
+    EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+    EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+    EGL_DEPTH_SIZE, 24, EGL_STENCIL_SIZE, 8,
+    EGL_NONE,
+  };
+  EGLConfig config;
+  EGLint count = 0;
+  if (!eglChooseConfig(g_display, config_attributes, &config, 1, &count) || count == 0) {
+    fail("eglChooseConfig"); return nullptr;
+  }
+  g_surface = eglCreateWindowSurface(g_display, config, nwindowGetDefault(), nullptr);
+  if (g_surface == EGL_NO_SURFACE) { fail("eglCreateWindowSurface"); return nullptr; }
+  // The renderer asks for 4.5 core (its Linux requirement); 4.3 is the floor it can run on.
+  for (EGLint minor : {6, 5, 3}) {
+    const EGLint context_attributes[] = {
+      EGL_CONTEXT_MAJOR_VERSION, 4, EGL_CONTEXT_MINOR_VERSION, minor,
+      EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+      EGL_NONE,
+    };
+    g_context = eglCreateContext(g_display, config, EGL_NO_CONTEXT, context_attributes);
+    if (g_context != EGL_NO_CONTEXT) break;
+  }
+  if (g_context == EGL_NO_CONTEXT) { fail("eglCreateContext (OpenGL 4.x core)"); return nullptr; }
+  if (!eglMakeCurrent(g_display, g_surface, g_surface, g_context)) { fail("eglMakeCurrent"); return nullptr; }
+  switch_host::log("gl: OpenGL %s, %s, GLSL %s", glGetString(GL_VERSION), glGetString(GL_RENDERER),
+                   glGetString(GL_SHADING_LANGUAGE_VERSION));
+  return g_context;
+}
+
+void SDL_GL_DeleteContext(SDL_GLContext) {
+  if (g_display == EGL_NO_DISPLAY) return;
+  eglMakeCurrent(g_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  if (g_context != EGL_NO_CONTEXT) eglDestroyContext(g_display, g_context);
+  if (g_surface != EGL_NO_SURFACE) eglDestroySurface(g_display, g_surface);
+  eglTerminate(g_display);
+  eglReleaseThread();   // and the driver's per-thread state
+  g_display = EGL_NO_DISPLAY; g_surface = EGL_NO_SURFACE; g_context = EGL_NO_CONTEXT;
+}
+
+int SDL_GL_SetSwapInterval(int interval) { return eglSwapInterval(g_display, interval) ? 0 : -1; }
+// How long the swap in progress has been waiting for the screen (0: none): a launch that hangs with a
+// black screen shows here, for the watchdog in host_switch.cpp.
+static std::atomic<uint64_t> g_swap_started{0}, g_swaps{0}, g_swap_ticks{0};
+extern "C" const char* mu_render_stage(const char* now);
+extern "C" uint64_t mu_swap_ticks() { return g_swap_ticks.load(); }
+extern "C" uint64_t mu_swap_blocked_ms() {
+  const uint64_t started = g_swap_started.load();
+  return started ? armTicksToNs(armGetSystemTick() - started) / 1000000 : 0;
+}
+extern "C" uint64_t mu_swaps() { return g_swaps.load(); }
+void SDL_GL_SwapWindow(SDL_Window*) {
+  const char* before = mu_render_stage("handing the frame to the screen");
+  const uint64_t start = armGetSystemTick();
+  g_swap_started = start;
+  eglSwapBuffers(g_display, g_surface);
+  g_swap_started = 0;
+  g_swap_ticks += armGetSystemTick() - start;
+  mu_render_stage(before);
+  if (g_swaps.fetch_add(1) == 0) switch_host::log("gl: first frame reached the screen");
+}
+
+void SDL_GL_GetDrawableSize(SDL_Window*, int* w, int* h) {
+  EGLint width = 1280, height = 720;
+  if (g_surface != EGL_NO_SURFACE) {
+    eglQuerySurface(g_display, g_surface, EGL_WIDTH, &width);
+    eglQuerySurface(g_display, g_surface, EGL_HEIGHT, &height);
+  }
+  if (w) *w = width;
+  if (h) *h = height;
+}
+void SDL_GetWindowSize(SDL_Window* window, int* w, int* h) { SDL_GL_GetDrawableSize(window, w, h); }
+void* SDL_GL_GetProcAddress(const char* name) { return reinterpret_cast<void*>(eglGetProcAddress(name)); }
+bool SDL_GL_ExtensionSupported(const char* extension) { return mu_gl_extension(extension); }
+const char* SDL_GetError() { return g_error.c_str(); }
+void SDL_PumpEvents() {}
+void SDL_Delay(uint32_t ms) { svcSleepThread(int64_t(ms) * 1000000); }
