+static bool fills_4x3_width_check(const DrawCall& dc, const Frame& f, float* out_lo, float* out_hi) {
+  if (dc.vertex_count < 3 || dc.vertex_count > 1024 || dc.first_vertex + dc.vertex_count > f.vertices.size()) return false;
+  const bool ortho = dc.xf_regs[0x26] != 0;
+  // Each vertex may name its own model-view (the game's models mostly do): its row index, else the draw's.
+  const bool per_vertex = (dc.components & VB_HAS_POSMTXIDX) != 0;
+  const float* p = (const float*)&dc.xf_regs[0x20];
+  float lo = 1e9f, hi = -1e9f;
+  for (uint32_t i = 0; i < dc.vertex_count; ++i) {
+    const Vertex& v = f.vertices[dc.first_vertex + i];
+    const uint32_t row = (per_vertex ? v.posmtx : dc.matrix_index_a) & 63;
+    if (row + 3 > 64) return false;
+    const float* m = &dc.posMatrices[row * 4];
+    const float x = m[0] * v.pos[0] + m[1] * v.pos[1] + m[2] * v.pos[2] + m[3];
+    const float z = m[8] * v.pos[0] + m[9] * v.pos[1] + m[10] * v.pos[2] + m[11];
